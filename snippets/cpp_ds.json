{
  "DSU": {
    "prefix": [
      "ds_dsu"
    ],
    "description": "Disjoint set union with union by size and path compression",
    "body": [
      "struct DSU {",
      "    int n;",
      "    vector<int> p, sz;",
      "",
      "    DSU(int n = 0) {",
      "        init(n);",
      "    }",
      "",
      "    void init(int n_) {",
      "        n = n_;",
      "        p.resize(n + 1);",
      "        sz.assign(n + 1, 1);",
      "        iota(p.begin(), p.end(), 0);",
      "    }",
      "",
      "    int find(int x) {",
      "        if (p[x] == x) return x;",
      "        return p[x] = find(p[x]);",
      "    }",
      "",
      "    bool unite(int a, int b) {",
      "        a = find(a);",
      "        b = find(b);",
      "        if (a == b) return false;",
      "        if (sz[a] < sz[b]) swap(a, b);",
      "        p[b] = a;",
      "        sz[a] += sz[b];",
      "        return true;",
      "    }",
      "",
      "    bool same(int a, int b) {",
      "        return find(a) == find(b);",
      "    }",
      "",
      "    int size(int x) {",
      "        return sz[find(x)];",
      "    }",
      "};"
    ]
  },
  "DSU Rollback": {
    "prefix": [
      "ds_dsu_rb"
    ],
    "description": "Rollback DSU for offline dynamic connectivity",
    "body": [
      "struct DSURollback {",
      "    int n, comps;",
      "    vector<int> p, sz;",
      "    vector<pair<int, int>> hist;",
      "",
      "    DSURollback(int n = 0) {",
      "        init(n);",
      "    }",
      "",
      "    void init(int n_) {",
      "        n = n_;",
      "        comps = n;",
      "        p.resize(n + 1);",
      "        sz.assign(n + 1, 1);",
      "        iota(p.begin(), p.end(), 0);",
      "        hist.clear();",
      "    }",
      "",
      "    int find(int x) const {",
      "        while (x != p[x]) x = p[x];",
      "        return x;",
      "    }",
      "",
      "    int snapshot() const {",
      "        return (int)hist.size();",
      "    }",
      "",
      "    void rollback(int snap) {",
      "        while ((int)hist.size() > snap) {",
      "            auto [a, b] = hist.back();",
      "            hist.pop_back();",
      "            if (a == -1) continue;",
      "            sz[a] -= sz[b];",
      "            p[b] = b;",
      "            ++comps;",
      "        }",
      "    }",
      "",
      "    bool unite(int a, int b) {",
      "        a = find(a);",
      "        b = find(b);",
      "        if (a == b) {",
      "            hist.push_back({-1, -1});",
      "            return false;",
      "        }",
      "        if (sz[a] < sz[b]) swap(a, b);",
      "        p[b] = a;",
      "        sz[a] += sz[b];",
      "        hist.push_back({a, b});",
      "        --comps;",
      "        return true;",
      "    }",
      "",
      "    int size(int x) const {",
      "        return sz[find(x)];",
      "    }",
      "};"
    ]
  },
  "Fenwick Tree": {
    "prefix": [
      "ds_bit"
    ],
    "description": "Fenwick tree for point add and range sum",
    "body": [
      "template <class T = long long>",
      "struct Fenwick {",
      "    int n;",
      "    vector<T> bit;",
      "",
      "    Fenwick(int n = 0) {",
      "        init(n);",
      "    }",
      "",
      "    void init(int n_) {",
      "        n = n_;",
      "        bit.assign(n + 1, T());",
      "    }",
      "",
      "    void add(int idx, T val) {",
      "        for (; idx <= n; idx += idx & -idx) bit[idx] += val;",
      "    }",
      "",
      "    T sum_prefix(int idx) const {",
      "        T res = T();",
      "        for (; idx > 0; idx -= idx & -idx) res += bit[idx];",
      "        return res;",
      "    }",
      "",
      "    T range_sum(int l, int r) const {",
      "        if (l > r) return T();",
      "        return sum_prefix(r) - sum_prefix(l - 1);",
      "    }",
      "};"
    ]
  },
  "Fenwick Range Add Range Sum": {
    "prefix": [
      "ds_bit_rr"
    ],
    "description": "Two Fenwick trees for range add and range sum",
    "body": [
      "template <class T = long long>",
      "struct FenwickRange {",
      "    int n;",
      "    vector<T> bit1, bit2;",
      "",
      "    FenwickRange(int n = 0) {",
      "        init(n);",
      "    }",
      "",
      "    void init(int n_) {",
      "        n = n_;",
      "        bit1.assign(n + 1, T());",
      "        bit2.assign(n + 1, T());",
      "    }",
      "",
      "    void add(vector<T>& bit, int idx, T val) {",
      "        for (; idx <= n; idx += idx & -idx) bit[idx] += val;",
      "    }",
      "",
      "    T sum(const vector<T>& bit, int idx) const {",
      "        T res = T();",
      "        for (; idx > 0; idx -= idx & -idx) res += bit[idx];",
      "        return res;",
      "    }",
      "",
      "    void range_add(int l, int r, T val) {",
      "        if (l > r) return;",
      "        add(bit1, l, val);",
      "        add(bit1, r + 1, -val);",
      "        add(bit2, l, val * (l - 1));",
      "        add(bit2, r + 1, -val * r);",
      "    }",
      "",
      "    T prefix_sum(int idx) const {",
      "        return sum(bit1, idx) * idx - sum(bit2, idx);",
      "    }",
      "",
      "    T range_sum(int l, int r) const {",
      "        if (l > r) return T();",
      "        return prefix_sum(r) - prefix_sum(l - 1);",
      "    }",
      "};"
    ]
  },
  "Fenwick Tree 2D": {
    "prefix": [
      "ds_bit2"
    ],
    "description": "2D Fenwick tree for point add and rectangle sum",
    "body": [
      "template <class T = long long>",
      "struct Fenwick2D {",
      "    int n, m;",
      "    vector<vector<T>> bit;",
      "",
      "    Fenwick2D(int n = 0, int m = 0) {",
      "        init(n, m);",
      "    }",
      "",
      "    void init(int n_, int m_) {",
      "        n = n_;",
      "        m = m_;",
      "        bit.assign(n + 1, vector<T>(m + 1, T()));",
      "    }",
      "",
      "    void add(int x, int y, T val) {",
      "        for (int i = x; i <= n; i += i & -i) {",
      "            for (int j = y; j <= m; j += j & -j) {",
      "                bit[i][j] += val;",
      "            }",
      "        }",
      "    }",
      "",
      "    T sum_prefix(int x, int y) const {",
      "        T res = T();",
      "        for (int i = x; i > 0; i -= i & -i) {",
      "            for (int j = y; j > 0; j -= j & -j) {",
      "                res += bit[i][j];",
      "            }",
      "        }",
      "        return res;",
      "    }",
      "",
      "    T rect_sum(int x1, int y1, int x2, int y2) const {",
      "        if (x1 > x2 || y1 > y2) return T();",
      "        return sum_prefix(x2, y2)",
      "             - sum_prefix(x1 - 1, y2)",
      "             - sum_prefix(x2, y1 - 1)",
      "             + sum_prefix(x1 - 1, y1 - 1);",
      "    }",
      "};"
    ]
  },
  "Segment Tree": {
    "prefix": [
      "ds_seg"
    ],
    "description": "Iterative segment tree with customizable monoid",
    "body": [
      "template <class T = long long>",
      "struct SegTree {",
      "    int n;",
      "    vector<T> st;",
      "",
      "    static T op(const T& a, const T& b) {",
      "        return a + b; // customize",
      "    }",
      "",
      "    static T id() {",
      "        return T(); // customize",
      "    }",
      "",
      "    SegTree(int n = 0) {",
      "        init(n);",
      "    }",
      "",
      "    void init(int n_) {",
      "        n = 1;",
      "        while (n < max(1, n_)) n <<= 1;",
      "        st.assign(2 * n, id());",
      "    }",
      "",
      "    void build(const vector<T>& a) {",
      "        init((int)a.size());",
      "        for (int i = 0; i < (int)a.size(); ++i) st[n + i] = a[i];",
      "        for (int i = n - 1; i > 0; --i) st[i] = op(st[i << 1], st[i << 1 | 1]);",
      "    }",
      "",
      "    void set_val(int p, T val) {",
      "        p += n;",
      "        st[p] = val;",
      "        for (p >>= 1; p; p >>= 1) st[p] = op(st[p << 1], st[p << 1 | 1]);",
      "    }",
      "",
      "    T query(int l, int r) const {",
      "        T left = id(), right = id();",
      "        for (l += n, r += n; l <= r; l >>= 1, r >>= 1) {",
      "            if (l & 1) left = op(left, st[l++]);",
      "            if (!(r & 1)) right = op(st[r--], right);",
      "        }",
      "        return op(left, right);",
      "    }",
      "};"
    ]
  },
  "Lazy Segment Tree": {
    "prefix": [
      "ds_lseg"
    ],
    "description": "Lazy segment tree for range add and range sum",
    "body": [
      "struct LazySegTree {",
      "    int n;",
      "    vector<long long> st, lz;",
      "",
      "    LazySegTree(int n = 0) {",
      "        init(n);",
      "    }",
      "",
      "    void init(int n_) {",
      "        n = max(1, n_);",
      "        st.assign(4 * n + 4, 0);",
      "        lz.assign(4 * n + 4, 0);",
      "    }",
      "",
      "    void build(const vector<long long>& a, int p, int l, int r) {",
      "        if (l == r) {",
      "            if (l < (int)a.size()) st[p] = a[l];",
      "            return;",
      "        }",
      "        int m = (l + r) >> 1;",
      "        build(a, p << 1, l, m);",
      "        build(a, p << 1 | 1, m + 1, r);",
      "        st[p] = st[p << 1] + st[p << 1 | 1];",
      "    }",
      "",
      "    void build(const vector<long long>& a) {",
      "        init((int)a.size());",
      "        build(a, 1, 0, n - 1);",
      "    }",
      "",
      "    void apply(int p, int l, int r, long long val) {",
      "        st[p] += val * (r - l + 1);",
      "        lz[p] += val;",
      "    }",
      "",
      "    void push(int p, int l, int r) {",
      "        if (lz[p] == 0 || l == r) return;",
      "        int m = (l + r) >> 1;",
      "        apply(p << 1, l, m, lz[p]);",
      "        apply(p << 1 | 1, m + 1, r, lz[p]);",
      "        lz[p] = 0;",
      "    }",
      "",
      "    void range_add(int ql, int qr, long long val, int p, int l, int r) {",
      "        if (qr < l || r < ql) return;",
      "        if (ql <= l && r <= qr) {",
      "            apply(p, l, r, val);",
      "            return;",
      "        }",
      "        push(p, l, r);",
      "        int m = (l + r) >> 1;",
      "        range_add(ql, qr, val, p << 1, l, m);",
      "        range_add(ql, qr, val, p << 1 | 1, m + 1, r);",
      "        st[p] = st[p << 1] + st[p << 1 | 1];",
      "    }",
      "",
      "    long long query(int ql, int qr, int p, int l, int r) {",
      "        if (qr < l || r < ql) return 0;",
      "        if (ql <= l && r <= qr) return st[p];",
      "        push(p, l, r);",
      "        int m = (l + r) >> 1;",
      "        return query(ql, qr, p << 1, l, m) + query(ql, qr, p << 1 | 1, m + 1, r);",
      "    }",
      "",
      "    void range_add(int l, int r, long long val) {",
      "        range_add(l, r, val, 1, 0, n - 1);",
      "    }",
      "",
      "    long long query(int l, int r) {",
      "        return query(l, r, 1, 0, n - 1);",
      "    }",
      "};"
    ]
  },
  "Persistent Segment Tree": {
    "prefix": [
      "ds_pseg"
    ],
    "description": "Persistent segment tree for frequency versions and kth queries",
    "body": [
      "struct PersistentSegTree {",
      "    struct Node {",
      "        int left = 0, right = 0, sum = 0;",
      "    };",
      "",
      "    vector<Node> st{{}};",
      "",
      "    int update(int prev, int l, int r, int idx, int val) {",
      "        int cur = (int)st.size();",
      "        st.push_back(st[prev]);",
      "        st[cur].sum += val;",
      "        if (l != r) {",
      "            int m = (l + r) >> 1;",
      "            if (idx <= m) st[cur].left = update(st[prev].left, l, m, idx, val);",
      "            else st[cur].right = update(st[prev].right, m + 1, r, idx, val);",
      "        }",
      "        return cur;",
      "    }",
      "",
      "    int kth(int left_root, int right_root, int l, int r, int k) const {",
      "        if (l == r) return l;",
      "        int m = (l + r) >> 1;",
      "        int left_count = st[st[right_root].left].sum - st[st[left_root].left].sum;",
      "        if (k <= left_count) return kth(st[left_root].left, st[right_root].left, l, m, k);",
      "        return kth(st[left_root].right, st[right_root].right, m + 1, r, k - left_count);",
      "    }",
      "",
      "    int count_leq(int left_root, int right_root, int l, int r, int qr) const {",
      "        if (qr < l) return 0;",
      "        if (r <= qr) return st[right_root].sum - st[left_root].sum;",
      "        int m = (l + r) >> 1;",
      "        return count_leq(st[left_root].left, st[right_root].left, l, m, qr)",
      "             + count_leq(st[left_root].right, st[right_root].right, m + 1, r, qr);",
      "    }",
      "};"
    ]
  },
  "Sparse Table": {
    "prefix": [
      "ds_sparse"
    ],
    "description": "Sparse table for idempotent range queries",
    "body": [
      "template <class T = long long>",
      "struct SparseTable {",
      "    int n, lg;",
      "    vector<int> lg2;",
      "    vector<vector<T>> st;",
      "",
      "    static T op(const T& a, const T& b) {",
      "        return min(a, b); // customize",
      "    }",
      "",
      "    SparseTable() : n(0), lg(0) {}",
      "",
      "    explicit SparseTable(const vector<T>& a) {",
      "        build(a);",
      "    }",
      "",
      "    void build(const vector<T>& a) {",
      "        n = (int)a.size();",
      "        if (n == 0) {",
      "            lg = 0;",
      "            lg2 = {0};",
      "            st.clear();",
      "            return;",
      "        }",
      "        lg = 32 - __builtin_clz(n);",
      "        lg2.assign(n + 1, 0);",
      "        for (int i = 2; i <= n; ++i) lg2[i] = lg2[i >> 1] + 1;",
      "        st.assign(lg, vector<T>(n));",
      "        st[0] = a;",
      "        for (int k = 1; k < lg; ++k) {",
      "            for (int i = 0; i + (1 << k) <= n; ++i) {",
      "                st[k][i] = op(st[k - 1][i], st[k - 1][i + (1 << (k - 1))]);",
      "            }",
      "        }",
      "    }",
      "",
      "    T query(int l, int r) const {",
      "        int k = lg2[r - l + 1];",
      "        return op(st[k][l], st[k][r - (1 << k) + 1]);",
      "    }",
      "};"
    ]
  },
  "Trie": {
    "prefix": [
      "ds_trie"
    ],
    "description": "Lowercase trie with terminal counts",
    "body": [
      "struct Trie {",
      "    struct Node {",
      "        array<int, 26> nxt;",
      "        int pass = 0, term = 0;",
      "",
      "        Node() {",
      "            nxt.fill(-1);",
      "        }",
      "    };",
      "",
      "    vector<Node> t{{}};",
      "",
      "    int new_node() {",
      "        t.push_back(Node());",
      "        return (int)t.size() - 1;",
      "    }",
      "",
      "    void insert(const string& s) {",
      "        int u = 0;",
      "        ++t[u].pass;",
      "        for (char ch : s) {",
      "            int c = ch - 'a';",
      "            if (t[u].nxt[c] == -1) t[u].nxt[c] = new_node();",
      "            u = t[u].nxt[c];",
      "            ++t[u].pass;",
      "        }",
      "        ++t[u].term;",
      "    }",
      "",
      "    bool contains(const string& s) const {",
      "        int u = 0;",
      "        for (char ch : s) {",
      "            int c = ch - 'a';",
      "            if (t[u].nxt[c] == -1) return false;",
      "            u = t[u].nxt[c];",
      "        }",
      "        return t[u].term > 0;",
      "    }",
      "",
      "    int count_prefix(const string& s) const {",
      "        int u = 0;",
      "        for (char ch : s) {",
      "            int c = ch - 'a';",
      "            if (t[u].nxt[c] == -1) return 0;",
      "            u = t[u].nxt[c];",
      "        }",
      "        return t[u].pass;",
      "    }",
      "};"
    ]
  },
  "Binary XOR Trie": {
    "prefix": [
      "ds_xtrie"
    ],
    "description": "Binary trie supporting insert, erase, and maximum xor",
    "body": [
      "struct XorTrie {",
      "    struct Node {",
      "        int child[2] = {-1, -1};",
      "        int cnt = 0;",
      "    };",
      "",
      "    static const int LOG = 60;",
      "    vector<Node> t{{}};",
      "",
      "    int new_node() {",
      "        t.push_back(Node());",
      "        return (int)t.size() - 1;",
      "    }",
      "",
      "    void insert(long long x) {",
      "        int u = 0;",
      "        ++t[u].cnt;",
      "        for (int b = LOG; b >= 0; --b) {",
      "            int bit = (x >> b) & 1;",
      "            if (t[u].child[bit] == -1) t[u].child[bit] = new_node();",
      "            u = t[u].child[bit];",
      "            ++t[u].cnt;",
      "        }",
      "    }",
      "",
      "    void erase(long long x) {",
      "        int u = 0;",
      "        --t[u].cnt;",
      "        for (int b = LOG; b >= 0; --b) {",
      "            int bit = (x >> b) & 1;",
      "            u = t[u].child[bit];",
      "            --t[u].cnt;",
      "        }",
      "    }",
      "",
      "    long long max_xor(long long x) const {",
      "        int u = 0;",
      "        long long res = 0;",
      "        for (int b = LOG; b >= 0; --b) {",
      "            int bit = (x >> b) & 1;",
      "            int want = bit ^ 1;",
      "            if (t[u].child[want] != -1 && t[t[u].child[want]].cnt > 0) {",
      "                res |= 1LL << b;",
      "                u = t[u].child[want];",
      "            } else {",
      "                u = t[u].child[bit];",
      "            }",
      "        }",
      "        return res;",
      "    }",
      "};"
    ]
  },
  "Convex Hull Trick Deque": {
    "prefix": [
      "ds_cht"
    ],
    "description": "Monotone CHT for minimum queries with monotone slopes and queries",
    "body": [
      "struct CHTDeque {",
      "    struct Line {",
      "        long long m, b;",
      "",
      "        long long eval(long long x) const {",
      "            return m * x + b;",
      "        }",
      "    };",
      "",
      "    deque<Line> dq;",
      "",
      "    static bool bad(const Line& a, const Line& b, const Line& c) {",
      "        return (__int128)(b.b - a.b) * (b.m - c.m) >= (__int128)(c.b - b.b) * (a.m - b.m);",
      "    }",
      "",
      "    void add_line(long long m, long long b) {",
      "        Line cur{m, b};",
      "        while ((int)dq.size() >= 2 && bad(dq[(int)dq.size() - 2], dq.back(), cur)) dq.pop_back();",
      "        dq.push_back(cur);",
      "    }",
      "",
      "    long long query(long long x) {",
      "        while ((int)dq.size() >= 2 && dq[0].eval(x) >= dq[1].eval(x)) dq.pop_front();",
      "        return dq.front().eval(x);",
      "    }",
      "};"
    ]
  },
  "Li Chao Tree": {
    "prefix": [
      "ds_lichao"
    ],
    "description": "Li Chao tree for minimum of lines on integer domain",
    "body": [
      "struct LiChao {",
      "    struct Line {",
      "        long long m = 0, b = (1LL << 62);",
      "",
      "        long long eval(long long x) const {",
      "            return m * x + b;",
      "        }",
      "    };",
      "",
      "    struct Node {",
      "        Line line;",
      "        Node* left = nullptr;",
      "        Node* right = nullptr;",
      "    };",
      "",
      "    long long lo, hi;",
      "    Node* root = nullptr;",
      "",
      "    LiChao(long long lo_, long long hi_) : lo(lo_), hi(hi_) {}",
      "",
      "    void add_line(Line nw) {",
      "        add_line(root, lo, hi, nw);",
      "    }",
      "",
      "    long long query(long long x) const {",
      "        return query(root, lo, hi, x);",
      "    }",
      "",
      "    void add_line(Node*& node, long long l, long long r, Line nw) {",
      "        if (!node) {",
      "            node = new Node();",
      "            node->line = nw;",
      "            return;",
      "        }",
      "        long long m = (l + r) >> 1;",
      "        bool lef = nw.eval(l) < node->line.eval(l);",
      "        bool mid = nw.eval(m) < node->line.eval(m);",
      "        if (mid) swap(node->line, nw);",
      "        if (l == r) return;",
      "        if (lef != mid) add_line(node->left, l, m, nw);",
      "        else add_line(node->right, m + 1, r, nw);",
      "    }",
      "",
      "    long long query(Node* node, long long l, long long r, long long x) const {",
      "        if (!node) return (1LL << 62);",
      "        long long res = node->line.eval(x);",
      "        if (l == r) return res;",
      "        long long m = (l + r) >> 1;",
      "        if (x <= m) return min(res, query(node->left, l, m, x));",
      "        return min(res, query(node->right, m + 1, r, x));",
      "    }",
      "};"
    ]
  },
  "Implicit Treap": {
    "prefix": [
      "ds_treap"
    ],
    "description": "Implicit treap for sequence operations",
    "body": [
      "struct ImplicitTreap {",
      "    struct Node {",
      "        int prior, sz;",
      "        long long val, sum;",
      "        bool rev;",
      "        Node *l, *r;",
      "",
      "        Node(long long v, int p) : prior(p), sz(1), val(v), sum(v), rev(false), l(nullptr), r(nullptr) {}",
      "    };",
      "",
      "    mt19937 rng{(uint32_t)chrono::steady_clock::now().time_since_epoch().count()};",
      "    Node* root = nullptr;",
      "",
      "    int size(Node* t) const {",
      "        return t ? t->sz : 0;",
      "    }",
      "",
      "    long long sum(Node* t) const {",
      "        return t ? t->sum : 0;",
      "    }",
      "",
      "    void push(Node* t) {",
      "        if (!t || !t->rev) return;",
      "        swap(t->l, t->r);",
      "        if (t->l) t->l->rev ^= 1;",
      "        if (t->r) t->r->rev ^= 1;",
      "        t->rev = false;",
      "    }",
      "",
      "    void pull(Node* t) {",
      "        if (!t) return;",
      "        t->sz = 1 + size(t->l) + size(t->r);",
      "        t->sum = t->val + sum(t->l) + sum(t->r);",
      "    }",
      "",
      "    void split(Node* t, int k, Node*& a, Node*& b) {",
      "        if (!t) {",
      "            a = b = nullptr;",
      "            return;",
      "        }",
      "        push(t);",
      "        if (size(t->l) >= k) {",
      "            split(t->l, k, a, t->l);",
      "            b = t;",
      "        } else {",
      "            split(t->r, k - size(t->l) - 1, t->r, b);",
      "            a = t;",
      "        }",
      "        pull(t);",
      "    }",
      "",
      "    Node* merge(Node* a, Node* b) {",
      "        if (!a || !b) return a ? a : b;",
      "        if (a->prior > b->prior) {",
      "            push(a);",
      "            a->r = merge(a->r, b);",
      "            pull(a);",
      "            return a;",
      "        } else {",
      "            push(b);",
      "            b->l = merge(a, b->l);",
      "            pull(b);",
      "            return b;",
      "        }",
      "    }",
      "",
      "    void insert(int pos, long long val) {",
      "        Node *a, *b;",
      "        split(root, pos, a, b);",
      "        root = merge(merge(a, new Node(val, (int)rng())), b);",
      "    }",
      "",
      "    void erase(int l, int r) {",
      "        Node *a, *b, *c;",
      "        split(root, r + 1, b, c);",
      "        split(b, l, a, b);",
      "        root = merge(a, c);",
      "    }",
      "",
      "    void reverse(int l, int r) {",
      "        Node *a, *b, *c;",
      "        split(root, r + 1, b, c);",
      "        split(b, l, a, b);",
      "        if (b) b->rev ^= 1;",
      "        root = merge(merge(a, b), c);",
      "    }",
      "",
      "    long long range_sum(int l, int r) {",
      "        Node *a, *b, *c;",
      "        split(root, r + 1, b, c);",
      "        split(b, l, a, b);",
      "        long long res = sum(b);",
      "        root = merge(merge(a, b), c);",
      "        return res;",
      "    }",
      "};"
    ]
  }
