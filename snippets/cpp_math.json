{
  "ModInt": {
    "prefix": [
      "mt_modint"
    ],
    "description": "Modint template with compile-time MOD",
    "body": [
      "template <int MOD>",
      "struct ModInt {",
      "    int v;",
      "",
      "    ModInt(long long x = 0) {",
      "        x %= MOD;",
      "        if (x < 0) x += MOD;",
      "        v = (int)x;",
      "    }",
      "",
      "    static int mod() {",
      "        return MOD;",
      "    }",
      "",
      "    ModInt& operator+=(const ModInt& other) {",
      "        v += other.v;",
      "        if (v >= MOD) v -= MOD;",
      "        return *this;",
      "    }",
      "",
      "    ModInt& operator-=(const ModInt& other) {",
      "        v -= other.v;",
      "        if (v < 0) v += MOD;",
      "        return *this;",
      "    }",
      "",
      "    ModInt& operator*=(const ModInt& other) {",
      "        v = (int)((long long)v * other.v % MOD);",
      "        return *this;",
      "    }",
      "",
      "    static ModInt pow(ModInt a, long long e) {",
      "        ModInt r = 1;",
      "        while (e > 0) {",
      "            if (e & 1) r *= a;",
      "            a *= a;",
      "            e >>= 1;",
      "        }",
      "        return r;",
      "    }",
      "",
      "    static ModInt inv(ModInt a) {",
      "        return pow(a, MOD - 2);",
      "    }",
      "",
      "    ModInt& operator/=(const ModInt& other) {",
      "        return *this *= inv(other);",
      "    }",
      "",
      "    friend ModInt operator+(ModInt a, const ModInt& b) { return a += b; }",
      "    friend ModInt operator-(ModInt a, const ModInt& b) { return a -= b; }",
      "    friend ModInt operator*(ModInt a, const ModInt& b) { return a *= b; }",
      "    friend ModInt operator/(ModInt a, const ModInt& b) { return a /= b; }",
      "    friend bool operator==(const ModInt& a, const ModInt& b) { return a.v == b.v; }",
      "    friend bool operator!=(const ModInt& a, const ModInt& b) { return a.v != b.v; }",
      "};"
    ]
  },
  "Linear Sieve SPF": {
    "prefix": [
      "mt_sieve"
    ],
    "description": "Linear sieve with primes and smallest prime factor",
    "body": [
      "struct LinearSieve {",
      "    int n;",
      "    vector<int> primes, spf;",
      "",
      "    LinearSieve(int n = 0) {",
      "        if (n) build(n);",
      "    }",
      "",
      "    void build(int n_) {",
      "        n = n_;",
      "        primes.clear();",
      "        spf.assign(n + 1, 0);",
      "        for (int i = 2; i <= n; ++i) {",
      "            if (!spf[i]) {",
      "                spf[i] = i;",
      "                primes.push_back(i);",
      "            }",
      "            for (int p : primes) {",
      "                if (p > spf[i] || 1LL * i * p > n) break;",
      "                spf[i * p] = p;",
      "            }",
      "        }",
      "    }",
      "",
      "    vector<pair<int, int>> factorize(int x) const {",
      "        vector<pair<int, int>> res;",
      "        while (x > 1) {",
      "            int p = spf[x], c = 0;",
      "            while (x % p == 0) {",
      "                x /= p;",
      "                ++c;",
      "            }",
      "            res.push_back({p, c});",
      "        }",
      "        return res;",
      "    }",
      "};"
    ]
  },
  "Phi Mu Sieve": {
    "prefix": [
      "mt_phi_mu"
    ],
    "description": "Linear sieve for phi and mobius",
    "body": [
      "struct PhiMuSieve {",
      "    int n;",
      "    vector<int> primes, spf, phi, mu, is_comp;",
      "",
      "    PhiMuSieve(int n = 0) {",
      "        if (n) build(n);",
      "    }",
      "",
      "    void build(int n_) {",
      "        n = n_;",
      "        primes.clear();",
      "        spf.assign(n + 1, 0);",
      "        phi.assign(n + 1, 0);",
      "        mu.assign(n + 1, 0);",
      "        is_comp.assign(n + 1, 0);",
      "        phi[1] = 1;",
      "        mu[1] = 1;",
      "        for (int i = 2; i <= n; ++i) {",
      "            if (!is_comp[i]) {",
      "                primes.push_back(i);",
      "                spf[i] = i;",
      "                phi[i] = i - 1;",
      "                mu[i] = -1;",
      "            }",
      "            for (int p : primes) {",
      "                if (1LL * i * p > n) break;",
      "                is_comp[i * p] = 1;",
      "                spf[i * p] = p;",
      "                if (i % p == 0) {",
      "                    phi[i * p] = phi[i] * p;",
      "                    mu[i * p] = 0;",
      "                    break;",
      "                } else {",
      "                    phi[i * p] = phi[i] * (p - 1);",
      "                    mu[i * p] = -mu[i];",
      "                }",
      "            }",
      "        }",
      "    }",
      "};"
    ]
  },
  "Combinatorics Factorials": {
    "prefix": [
      "mt_comb"
    ],
    "description": "Factorials and binomial coefficients modulo mod",
    "body": [
      "struct Comb {",
      "    int n;",
      "    long long mod;",
      "    vector<long long> fac, ifac;",
      "",
      "    Comb(int n = 0, long long mod = 1000000007LL) {",
      "        if (n) init(n, mod);",
      "        else this->mod = mod;",
      "    }",
      "",
      "    long long mod_pow(long long a, long long e) const {",
      "        long long r = 1 % mod;",
      "        while (e > 0) {",
      "            if (e & 1) r = (__int128)r * a % mod;",
      "            a = (__int128)a * a % mod;",
      "            e >>= 1;",
      "        }",
      "        return r;",
      "    }",
      "",
      "    void init(int n_, long long mod_) {",
      "        n = n_;",
      "        mod = mod_;",
      "        fac.assign(n + 1, 1);",
      "        ifac.assign(n + 1, 1);",
      "        for (int i = 1; i <= n; ++i) fac[i] = (__int128)fac[i - 1] * i % mod;",
      "        ifac[n] = mod_pow(fac[n], mod - 2);",
      "        for (int i = n; i > 0; --i) ifac[i - 1] = (__int128)ifac[i] * i % mod;",
      "    }",
      "",
      "    long long C(int nn, int kk) const {",
      "        if (kk < 0 || kk > nn) return 0;",
      "        return (__int128)fac[nn] * ifac[kk] % mod * ifac[nn - kk] % mod;",
      "    }",
      "",
      "    long long P(int nn, int kk) const {",
      "        if (kk < 0 || kk > nn) return 0;",
      "        return (__int128)fac[nn] * ifac[nn - kk] % mod;",
      "    }",
      "};"
    ]
  },
  "Extended GCD and Mod Inverse": {
    "prefix": [
      "mt_extgcd"
    ],
    "description": "Extended Euclid and modular inverse",
    "body": [
      "long long ext_gcd(long long a, long long b, long long& x, long long& y) {",
      "    if (b == 0) {",
      "        x = 1;",
      "        y = 0;",
      "        return a;",
      "    }",
      "    long long x1, y1;",
      "    long long g = ext_gcd(b, a % b, x1, y1);",
      "    x = y1;",
      "    y = x1 - y1 * (a / b);",
      "    return g;",
      "}",
      "",
      "long long mod_inverse(long long a, long long mod) {",
      "    long long x, y;",
      "    long long g = ext_gcd(a, mod, x, y);",
      "    if (g != 1) return -1;",
      "    x %= mod;",
      "    if (x < 0) x += mod;",
      "    return x;",
      "}"
    ]
  },
  "Chinese Remainder Theorem": {
    "prefix": [
      "mt_crt"
    ],
    "description": "Merge congruences, returns {remainder, modulus} or {0,-1}",
    "body": [
      "long long crt_ext_gcd(long long a, long long b, long long& x, long long& y) {",
      "    if (b == 0) {",
      "        x = 1;",
      "        y = 0;",
      "        return a;",
      "    }",
      "    long long x1, y1;",
      "    long long g = crt_ext_gcd(b, a % b, x1, y1);",
      "    x = y1;",
      "    y = x1 - y1 * (a / b);",
      "    return g;",
      "}",
      "",
      "pair<long long, long long> crt_merge(pair<long long, long long> a, pair<long long, long long> b) {",
      "    auto [r1, m1] = a;",
      "    auto [r2, m2] = b;",
      "    long long x, y;",
      "    long long g = crt_ext_gcd(m1, m2, x, y);",
      "    if ((r2 - r1) % g != 0) return {0, -1};",
      "    __int128 lcm = (__int128)m1 / g * m2;",
      "    __int128 t = (__int128)(r2 - r1) / g * x;",
      "    long long mod = (long long)lcm;",
      "    long long add = (long long)((t % (m2 / g) + (m2 / g)) % (m2 / g));",
      "    long long res = (long long)(((__int128)m1 * add + r1) % lcm);",
      "    if (res < 0) res += mod;",
      "    return {res, mod};",
      "}"
    ]
  },
  "Matrix Exponentiation": {
    "prefix": [
      "mt_matpow"
    ],
    "description": "Matrix multiplication and fast exponentiation modulo mod",
    "body": [
      "struct Matrix {",
      "    int n;",
      "    long long mod;",
      "    vector<vector<long long>> a;",
      "",
      "    Matrix(int n = 0, long long mod = 1000000007LL, bool ident = false) : n(n), mod(mod), a(n, vector<long long>(n, 0)) {",
      "        if (ident) {",
      "            for (int i = 0; i < n; ++i) a[i][i] = 1 % mod;",
      "        }",
      "    }",
      "",
      "    vector<long long>& operator[](int i) {",
      "        return a[i];",
      "    }",
      "",
      "    const vector<long long>& operator[](int i) const {",
      "        return a[i];",
      "    }",
      "",
      "    static Matrix multiply(const Matrix& x, const Matrix& y) {",
      "        Matrix res(x.n, x.mod);",
      "        for (int i = 0; i < x.n; ++i) {",
      "            for (int k = 0; k < x.n; ++k) {",
      "                if (!x[i][k]) continue;",
      "                for (int j = 0; j < x.n; ++j) {",
      "                    res[i][j] = (res[i][j] + (__int128)x[i][k] * y[k][j]) % x.mod;",
      "                }",
      "            }",
      "        }",
      "        return res;",
      "    }",
      "",
      "    static Matrix power(Matrix base, long long exp) {",
      "        Matrix res(base.n, base.mod, true);",
      "        while (exp > 0) {",
      "            if (exp & 1) res = multiply(res, base);",
      "            base = multiply(base, base);",
      "            exp >>= 1;",
      "        }",
      "        return res;",
      "    }",
      "};"
    ]
  },
  "XOR Basis": {
    "prefix": [
      "mt_xbasis"
    ],
    "description": "Linear basis over xor",
    "body": [
      "struct XorBasis {",
      "    static const int LOG = 60;",
      "    array<long long, LOG + 1> basis{};",
      "",
      "    bool insert(long long x) {",
      "        long long y = x;",
      "        for (int b = LOG; b >= 0; --b) {",
      "            if (((y >> b) & 1) == 0) continue;",
      "            if (!basis[b]) {",
      "                basis[b] = y;",
      "                return true;",
      "            }",
      "            y ^= basis[b];",
      "        }",
      "        return false;",
      "    }",
      "",
      "    long long max_xor(long long start = 0) const {",
      "        long long res = start;",
      "        for (int b = LOG; b >= 0; --b) {",
      "            res = max(res, res ^ basis[b]);",
      "        }",
      "        return res;",
      "    }",
      "",
      "    bool can_make(long long x) const {",
      "        long long y = x;",
      "        for (int b = LOG; b >= 0; --b) {",
      "            if (((y >> b) & 1) == 0) continue;",
      "            if (!basis[b]) return false;",
      "            y ^= basis[b];",
      "        }",
      "        return true;",
      "    }",
      "};"
    ]
  },
  "Miller Rabin 64 bit": {
    "prefix": [
      "mt_miller"
    ],
    "description": "Deterministic Miller-Rabin primality test for uint64",
    "body": [
      "using u64 = uint64_t;",
      "using u128 = __uint128_t;",
      "",
      "u64 mod_mul_u64(u64 a, u64 b, u64 mod) {",
      "    return (u128)a * b % mod;",
      "}",
      "",
      "u64 mod_pow_u64(u64 a, u64 e, u64 mod) {",
      "    u64 r = 1 % mod;",
      "    while (e > 0) {",
      "        if (e & 1) r = mod_mul_u64(r, a, mod);",
      "        a = mod_mul_u64(a, a, mod);",
      "        e >>= 1;",
      "    }",
      "    return r;",
      "}",
      "",
      "bool is_prime_u64(u64 n) {",
      "    if (n < 2) return false;",
      "    for (u64 p : {2ULL, 3ULL, 5ULL, 7ULL, 11ULL, 13ULL, 17ULL, 19ULL, 23ULL, 29ULL, 31ULL, 37ULL}) {",
      "        if (n % p == 0) return n == p;",
      "    }",
      "    u64 d = n - 1, s = 0;",
      "    while ((d & 1) == 0) {",
      "        d >>= 1;",
      "        ++s;",
      "    }",
      "    for (u64 a : {2ULL, 325ULL, 9375ULL, 28178ULL, 450775ULL, 9780504ULL, 1795265022ULL}) {",
      "        if (a % n == 0) continue;",
      "        u64 x = mod_pow_u64(a % n, d, n);",
      "        if (x == 1 || x == n - 1) continue;",
      "        bool comp = true;",
      "        for (u64 r = 1; r < s; ++r) {",
      "            x = mod_mul_u64(x, x, n);",
      "            if (x == n - 1) {",
      "                comp = false;",
      "                break;",
      "            }",
      "        }",
      "        if (comp) return false;",
      "    }",
      "    return true;",
      "}"
    ]
  },
  "Pollard Rho": {
    "prefix": [
      "mt_pollard"
    ],
    "description": "Pollard-Rho factorization for 64-bit integers",
    "body": [
      "using u64 = uint64_t;",
      "using u128 = __uint128_t;",
      "",
      "u64 pollard_mul(u64 a, u64 b, u64 mod) {",
      "    return (u128)a * b % mod;",
      "}",
      "",
      "u64 pollard_pow(u64 a, u64 e, u64 mod) {",
      "    u64 r = 1 % mod;",
      "    while (e > 0) {",
      "        if (e & 1) r = pollard_mul(r, a, mod);",
      "        a = pollard_mul(a, a, mod);",
      "        e >>= 1;",
      "    }",
      "    return r;",
      "}",
      "",
      "bool pollard_is_prime(u64 n) {",
      "    if (n < 2) return false;",
      "    for (u64 p : {2ULL, 3ULL, 5ULL, 7ULL, 11ULL, 13ULL, 17ULL, 19ULL, 23ULL, 29ULL, 31ULL, 37ULL}) {",
      "        if (n % p == 0) return n == p;",
      "    }",
      "    u64 d = n - 1, s = 0;",
      "    while ((d & 1) == 0) {",
      "        d >>= 1;",
      "        ++s;",
      "    }",
      "    for (u64 a : {2ULL, 325ULL, 9375ULL, 28178ULL, 450775ULL, 9780504ULL, 1795265022ULL}) {",
      "        if (a % n == 0) continue;",
      "        u64 x = pollard_pow(a % n, d, n);",
      "        if (x == 1 || x == n - 1) continue;",
      "        bool comp = true;",
      "        for (u64 r = 1; r < s; ++r) {",
      "            x = pollard_mul(x, x, n);",
      "            if (x == n - 1) {",
      "                comp = false;",
      "                break;",
      "            }",
      "        }",
      "        if (comp) return false;",
      "    }",
      "    return true;",
      "}",
      "",
      "u64 pollard_rho(u64 n) {",
      "    if (n % 2ULL == 0) return 2;",
      "    static mt19937_64 rng((uint64_t)chrono::steady_clock::now().time_since_epoch().count());",
      "    uniform_int_distribution<u64> dist(2, n - 2);",
      "    while (true) {",
      "        u64 c = dist(rng);",
      "        u64 x = dist(rng);",
      "        u64 y = x;",
      "        u64 d = 1;",
      "        auto f = [&](u64 v) { return (pollard_mul(v, v, n) + c) % n; };",
      "        while (d == 1) {",
      "            x = f(x);",
      "            y = f(f(y));",
      "            u64 diff = x > y ? x - y : y - x;",
      "            d = gcd(diff, n);",
      "        }",
      "        if (d != n) return d;",
      "    }",
      "}",
      "",
      "void factor_rec(u64 n, map<u64, int>& cnt) {",
      "    if (n == 1) return;",
      "    if (pollard_is_prime(n)) {",
      "        ++cnt[n];",
      "        return;",
      "    }",
      "    u64 d = pollard_rho(n);",
      "    factor_rec(d, cnt);",
      "    factor_rec(n / d, cnt);",
      "}"
    ]
  },
  "FFT Convolution": {
    "prefix": [
      "mt_fft"
    ],
    "description": "Complex FFT convolution on doubles/integers",
    "body": [
      "using cd = complex<long double>;",
      "const long double PI = acosl(-1.0L);",
      "",
      "void fft(vector<cd>& a, bool invert) {",
      "    int n = (int)a.size();",
      "    for (int i = 1, j = 0; i < n; ++i) {",
      "        int bit = n >> 1;",
      "        for (; j & bit; bit >>= 1) j ^= bit;",
      "        j ^= bit;",
      "        if (i < j) swap(a[i], a[j]);",
      "    }",
      "",
      "    for (int len = 2; len <= n; len <<= 1) {",
      "        long double ang = 2 * PI / len * (invert ? -1 : 1);",
      "        cd wlen(cosl(ang), sinl(ang));",
      "        for (int i = 0; i < n; i += len) {",
      "            cd w(1);",
      "            for (int j = 0; j < len / 2; ++j) {",
      "                cd u = a[i + j];",
      "                cd v = a[i + j + len / 2] * w;",
      "                a[i + j] = u + v;",
      "                a[i + j + len / 2] = u - v;",
      "                w *= wlen;",
      "            }",
      "        }",
      "    }",
      "",
      "    if (invert) {",
      "        for (auto& x : a) x /= n;",
      "    }",
      "}",
      "",
      "vector<long long> convolution_fft(const vector<long long>& a, const vector<long long>& b) {",
      "    vector<cd> fa(a.begin(), a.end()), fb(b.begin(), b.end());",
      "    int n = 1;",
      "    while (n < (int)a.size() + (int)b.size() - 1) n <<= 1;",
      "    fa.resize(n);",
      "    fb.resize(n);",
      "    fft(fa, false);",
      "    fft(fb, false);",
      "    for (int i = 0; i < n; ++i) fa[i] *= fb[i];",
      "    fft(fa, true);",
      "    vector<long long> res((int)a.size() + (int)b.size() - 1);",
      "    for (int i = 0; i < (int)res.size(); ++i) res[i] = llround(fa[i].real());",
      "    return res;",
      "}"
    ]
  },
  "NTT 998244353": {
    "prefix": [
      "mt_ntt"
    ],
    "description": "NTT convolution modulo 998244353",
    "body": [
      "const int NTT_MOD = 998244353;",
      "const int NTT_G = 3;",
      "",
      "int ntt_pow(int a, long long e) {",
      "    long long r = 1;",
      "    long long x = a;",
      "    while (e > 0) {",
      "        if (e & 1) r = r * x % NTT_MOD;",
      "        x = x * x % NTT_MOD;",
      "        e >>= 1;",
      "    }",
      "    return (int)r;",
      "}",
      "",
      "void ntt(vector<int>& a, bool invert) {",
      "    int n = (int)a.size();",
      "    for (int i = 1, j = 0; i < n; ++i) {",
      "        int bit = n >> 1;",
      "        for (; j & bit; bit >>= 1) j ^= bit;",
      "        j ^= bit;",
      "        if (i < j) swap(a[i], a[j]);",
      "    }",
      "",
      "    for (int len = 2; len <= n; len <<= 1) {",
      "        int wlen = ntt_pow(NTT_G, (NTT_MOD - 1) / len);",
      "        if (invert) wlen = ntt_pow(wlen, NTT_MOD - 2);",
      "        for (int i = 0; i < n; i += len) {",
      "            long long w = 1;",
      "            for (int j = 0; j < len / 2; ++j) {",
      "                int u = a[i + j];",
      "                int v = (int)(w * a[i + j + len / 2] % NTT_MOD);",
      "                a[i + j] = u + v < NTT_MOD ? u + v : u + v - NTT_MOD;",
      "                a[i + j + len / 2] = u - v >= 0 ? u - v : u - v + NTT_MOD;",
      "                w = w * wlen % NTT_MOD;",
      "            }",
      "        }",
      "    }",
      "",
      "    if (invert) {",
      "        int inv_n = ntt_pow(n, NTT_MOD - 2);",
      "        for (int& x : a) x = (int)(1LL * x * inv_n % NTT_MOD);",
      "    }",
      "}",
      "",
      "vector<int> convolution_ntt(vector<int> a, vector<int> b) {",
      "    int need = (int)a.size() + (int)b.size() - 1;",
      "    int n = 1;",
      "    while (n < need) n <<= 1;",
      "    a.resize(n);",
      "    b.resize(n);",
      "    ntt(a, false);",
      "    ntt(b, false);",
      "    for (int i = 0; i < n; ++i) a[i] = (int)(1LL * a[i] * b[i] % NTT_MOD);",
      "    ntt(a, true);",
      "    a.resize(need);",
      "    return a;",
      "}"
    ]
  },
  "FWHT XOR Convolution": {
    "prefix": [
      "mt_fwht"
    ],
    "description": "Fast Walsh-Hadamard transform for xor convolution",
    "body": [
      "long long fwht_ext_gcd(long long a, long long b, long long& x, long long& y) {",
      "    if (b == 0) {",
      "        x = 1;",
      "        y = 0;",
      "        return a;",
      "    }",
      "    long long x1, y1;",
      "    long long g = fwht_ext_gcd(b, a % b, x1, y1);",
      "    x = y1;",
      "    y = x1 - y1 * (a / b);",
      "    return g;",
      "}",
      "",
      "long long fwht_mod_inverse(long long a, long long mod) {",
      "    long long x, y;",
      "    long long g = fwht_ext_gcd(a, mod, x, y);",
      "    if (g != 1) return -1;",
      "    x %= mod;",
      "    if (x < 0) x += mod;",
      "    return x;",
      "}",
      "",
      "void fwht_xor(vector<long long>& a, bool inverse, long long mod = -1) {",
      "    int n = (int)a.size();",
      "    for (int len = 1; 2 * len <= n; len <<= 1) {",
      "        for (int i = 0; i < n; i += 2 * len) {",
      "            for (int j = 0; j < len; ++j) {",
      "                long long u = a[i + j];",
      "                long long v = a[i + j + len];",
      "                a[i + j] = u + v;",
      "                a[i + j + len] = u - v;",
      "                if (mod != -1) {",
      "                    a[i + j] %= mod;",
      "                    if (a[i + j] < 0) a[i + j] += mod;",
      "                    a[i + j + len] %= mod;",
      "                    if (a[i + j + len] < 0) a[i + j + len] += mod;",
      "                }",
      "            }",
      "        }",
      "    }",
      "",
      "    if (inverse) {",
      "        if (mod == -1) {",
      "            for (long long& x : a) x /= n;",
      "        } else {",
      "            long long inv_n = fwht_mod_inverse(n, mod);",
      "            for (long long& x : a) x = x * inv_n % mod;",
      "        }",
      "    }",
      "}",
      "",
      "vector<long long> xor_convolution(vector<long long> a, vector<long long> b, long long mod = -1) {",
      "    int n = 1;",
      "    while (n < max((int)a.size(), (int)b.size())) n <<= 1;",
      "    a.resize(n);",
      "    b.resize(n);",
      "    fwht_xor(a, false, mod);",
      "    fwht_xor(b, false, mod);",
      "    for (int i = 0; i < n; ++i) {",
      "        if (mod == -1) a[i] *= b[i];",
      "        else a[i] = a[i] * b[i] % mod;",
      "    }",
      "    fwht_xor(a, true, mod);",
      "    return a;",
      "}"
    ]
  },
  "Gaussian Elimination": {
    "prefix": [
      "mt_gauss"
    ],
    "description": "Gaussian elimination over doubles, returns rank or -1 if inconsistent",
    "body": [
      "int gauss(vector<vector<long double>> a, vector<long double>& ans, long double eps = 1e-12L) {",
      "    int n = (int)a.size();",
      "    int m = (int)a[0].size() - 1;",
      "    vector<int> where(m, -1);",
      "    for (int col = 0, row = 0; col < m && row < n; ++col) {",
      "        int sel = row;",
      "        for (int i = row; i < n; ++i) {",
      "            if (fabsl(a[i][col]) > fabsl(a[sel][col])) sel = i;",
      "        }",
      "        if (fabsl(a[sel][col]) < eps) continue;",
      "        swap(a[sel], a[row]);",
      "        where[col] = row;",
      "",
      "        long double inv = a[row][col];",
      "        for (int j = col; j <= m; ++j) a[row][j] /= inv;",
      "        for (int i = 0; i < n; ++i) {",
      "            if (i == row) continue;",
      "            long double factor = a[i][col];",
      "            for (int j = col; j <= m; ++j) a[i][j] -= factor * a[row][j];",
      "        }",
      "        ++row;",
      "    }",
      "",
      "    ans.assign(m, 0);",
      "    for (int i = 0; i < m; ++i) {",
      "        if (where[i] != -1) ans[i] = a[where[i]][m];",
      "    }",
      "",
      "    for (int i = 0; i < n; ++i) {",
      "        long double sum = 0;",
      "        for (int j = 0; j < m; ++j) sum += ans[j] * a[i][j];",
      "        if (fabsl(sum - a[i][m]) > 1e-9L) return -1;",
      "    }",
      "",
      "    int rank = 0;",
      "    for (int x : where) rank += (x != -1);",
      "    return rank;",
      "}"
    ]
  },
  "Baby Step Giant Step": {
    "prefix": [
      "mt_bsgs"
    ],
    "description": "Discrete logarithm for gcd(a, mod) = 1",
    "body": [
      "long long bsgs_ext_gcd(long long a, long long b, long long& x, long long& y) {",
      "    if (b == 0) {",
      "        x = 1;",
      "        y = 0;",
      "        return a;",
      "    }",
      "    long long x1, y1;",
      "    long long g = bsgs_ext_gcd(b, a % b, x1, y1);",
      "    x = y1;",
      "    y = x1 - y1 * (a / b);",
      "    return g;",
      "}",
      "",
      "long long bsgs_mod_inverse(long long a, long long mod) {",
      "    long long x, y;",
      "    long long g = bsgs_ext_gcd(a, mod, x, y);",
      "    if (g != 1) return -1;",
      "    x %= mod;",
      "    if (x < 0) x += mod;",
      "    return x;",
      "}",
      "",
      "long long bsgs(long long a, long long b, long long mod) {",
      "    a %= mod;",
      "    b %= mod;",
      "    if (mod == 1) return 0;",
      "    if (b == 1 % mod) return 0;",
      "",
      "    long long m = (long long)ceil(sqrt((long double)mod));",
      "    unordered_map<long long, long long> baby;",
      "    long long cur = 1 % mod;",
      "    for (long long j = 0; j < m; ++j) {",
      "        if (!baby.count(cur)) baby[cur] = j;",
      "        cur = (__int128)cur * a % mod;",
      "    }",
      "",
      "    long long inv_a = bsgs_mod_inverse(a, mod);",
      "    if (inv_a == -1) return -1;",
      "    long long factor = 1 % mod;",
      "    for (long long i = 0; i < m; ++i) factor = (__int128)factor * inv_a % mod;",
      "",
      "    cur = b;",
      "    for (long long i = 0; i <= m; ++i) {",
      "        if (baby.count(cur)) return i * m + baby[cur];",
      "        cur = (__int128)cur * factor % mod;",
      "    }",
      "    return -1;",
      "}"
    ]
  },
  "Floor Sum": {
    "prefix": [
      "mt_floor_sum"
    ],
    "description": "AtCoder floor_sum: sum_{i=0}^{n-1} floor((a*i+b)/m)",
    "body": [
      "long long floor_sum(long long n, long long m, long long a, long long b) {",
      "    long long ans = 0;",
      "    while (true) {",
      "        if (a >= m) {",
      "            ans += (n - 1) * n * (a / m) / 2;",
      "            a %= m;",
      "        }",
      "        if (b >= m) {",
      "            ans += n * (b / m);",
      "            b %= m;",
      "        }",
      "        long long y_max = a * n + b;",
      "        if (y_max < m) break;",
      "        n = y_max / m;",
      "        b = y_max % m;",
      "        swap(m, a);",
      "    }",
      "    return ans;",
      "}"
    ]
  }
}
