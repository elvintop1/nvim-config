{
  "Dijkstra": {
    "prefix": [
      "gr_dij"
    ],
    "description": "Shortest paths on non-negative weighted graph",
    "body": [
      "vector<long long> dijkstra(int n, const vector<vector<pair<int, long long>>>& g, int src) {",
      "    const long long INF = (1LL << 62);",
      "    vector<long long> dist(n + 1, INF);",
      "    priority_queue<pair<long long, int>, vector<pair<long long, int>>, greater<pair<long long, int>>> pq;",
      "    dist[src] = 0;",
      "    pq.push({0, src});",
      "    while (!pq.empty()) {",
      "        auto [d, u] = pq.top();",
      "        pq.pop();",
      "        if (d != dist[u]) continue;",
      "        for (auto [v, w] : g[u]) {",
      "            if (dist[v] > d + w) {",
      "                dist[v] = d + w;",
      "                pq.push({dist[v], v});",
      "            }",
      "        }",
      "    }",
      "    return dist;",
      "}"
    ]
  },
  "0-1 BFS": {
    "prefix": [
      "gr_bfs01"
    ],
    "description": "Shortest paths on graph with edge weights 0 or 1",
    "body": [
      "vector<int> zero_one_bfs(int n, const vector<vector<pair<int, int>>>& g, int src) {",
      "    const int INF = (int)1e9;",
      "    vector<int> dist(n + 1, INF);",
      "    deque<int> dq;",
      "    dist[src] = 0;",
      "    dq.push_front(src);",
      "    while (!dq.empty()) {",
      "        int u = dq.front();",
      "        dq.pop_front();",
      "        for (auto [v, w] : g[u]) {",
      "            if (dist[v] > dist[u] + w) {",
      "                dist[v] = dist[u] + w;",
      "                if (w == 0) dq.push_front(v);",
      "                else dq.push_back(v);",
      "            }",
      "        }",
      "    }",
      "    return dist;",
      "}"
    ]
  },
  "Bellman Ford": {
    "prefix": [
      "gr_bellman"
    ],
    "description": "Bellman-Ford with reachable negative cycle detection",
    "body": [
      "pair<bool, vector<long long>> bellman_ford(int n, const vector<tuple<int, int, long long>>& edges, int src) {",
      "    const long long INF = (1LL << 62);",
      "    vector<long long> dist(n + 1, INF);",
      "    dist[src] = 0;",
      "    for (int it = 1; it <= n - 1; ++it) {",
      "        bool changed = false;",
      "        for (auto [u, v, w] : edges) {",
      "            if (dist[u] == INF) continue;",
      "            if (dist[v] > dist[u] + w) {",
      "                dist[v] = dist[u] + w;",
      "                changed = true;",
      "            }",
      "        }",
      "        if (!changed) break;",
      "    }",
      "    for (auto [u, v, w] : edges) {",
      "        if (dist[u] != INF && dist[v] > dist[u] + w) return {true, dist};",
      "    }",
      "    return {false, dist};",
      "}"
    ]
  },
  "Floyd Warshall": {
    "prefix": [
      "gr_floyd"
    ],
    "description": "All-pairs shortest paths",
    "body": [
      "void floyd_warshall(vector<vector<long long>>& dist) {",
      "    int n = (int)dist.size();",
      "    const long long INF = (1LL << 62);",
      "    for (int k = 0; k < n; ++k) {",
      "        for (int i = 0; i < n; ++i) {",
      "            if (dist[i][k] >= INF) continue;",
      "            for (int j = 0; j < n; ++j) {",
      "                if (dist[k][j] >= INF) continue;",
      "                dist[i][j] = min(dist[i][j], dist[i][k] + dist[k][j]);",
      "            }",
      "        }",
      "    }",
      "}"
    ]
  },
  "Topological Sort": {
    "prefix": [
      "gr_topo"
    ],
    "description": "Kahn topological sort, empty result means cycle",
    "body": [
      "vector<int> topo_sort(int n, const vector<vector<int>>& g) {",
      "    vector<int> indeg(n + 1, 0);",
      "    for (int u = 1; u <= n; ++u) {",
      "        for (int v : g[u]) ++indeg[v];",
      "    }",
      "    queue<int> q;",
      "    for (int i = 1; i <= n; ++i) {",
      "        if (indeg[i] == 0) q.push(i);",
      "    }",
      "    vector<int> order;",
      "    while (!q.empty()) {",
      "        int u = q.front();",
      "        q.pop();",
      "        order.push_back(u);",
      "        for (int v : g[u]) {",
      "            if (--indeg[v] == 0) q.push(v);",
      "        }",
      "    }",
      "    if ((int)order.size() != n) return {};",
      "    return order;",
      "}"
    ]
  },
  "Strongly Connected Components": {
    "prefix": [
      "gr_scc"
    ],
    "description": "Kosaraju SCC decomposition",
    "body": [
      "struct SCC {",
      "    int n;",
      "    vector<vector<int>> g, rg, comps;",
      "    vector<int> order, comp, used;",
      "",
      "    SCC(int n = 0) {",
      "        init(n);",
      "    }",
      "",
      "    void init(int n_) {",
      "        n = n_;",
      "        g.assign(n + 1, {});",
      "        rg.assign(n + 1, {});",
      "    }",
      "",
      "    void add_edge(int u, int v) {",
      "        g[u].push_back(v);",
      "        rg[v].push_back(u);",
      "    }",
      "",
      "    void dfs1(int u) {",
      "        used[u] = 1;",
      "        for (int v : g[u]) {",
      "            if (!used[v]) dfs1(v);",
      "        }",
      "        order.push_back(u);",
      "    }",
      "",
      "    void dfs2(int u, int c) {",
      "        comp[u] = c;",
      "        comps.back().push_back(u);",
      "        for (int v : rg[u]) {",
      "            if (comp[v] == -1) dfs2(v, c);",
      "        }",
      "    }",
      "",
      "    int build() {",
      "        used.assign(n + 1, 0);",
      "        comp.assign(n + 1, -1);",
      "        order.clear();",
      "        comps.clear();",
      "        for (int i = 1; i <= n; ++i) {",
      "            if (!used[i]) dfs1(i);",
      "        }",
      "        reverse(order.begin(), order.end());",
      "        int cc = 0;",
      "        for (int u : order) {",
      "            if (comp[u] != -1) continue;",
      "            comps.push_back({});",
      "            dfs2(u, cc++);",
      "        }",
      "        return cc;",
      "    }",
      "};"
    ]
  },
  "Bridges and Articulation Points": {
    "prefix": [
      "gr_bcc"
    ],
    "description": "Tarjan bridges and articulation points on undirected graph",
    "body": [
      "struct BridgeArticulation {",
      "    int n, timer = 0;",
      "    vector<vector<pair<int, int>>> g;",
      "    vector<int> tin, low, is_art;",
      "    vector<pair<int, int>> bridges;",
      "",
      "    BridgeArticulation(int n = 0) {",
      "        init(n);",
      "    }",
      "",
      "    void init(int n_) {",
      "        n = n_;",
      "        timer = 0;",
      "        g.assign(n + 1, {});",
      "    }",
      "",
      "    void add_edge(int u, int v, int id) {",
      "        g[u].push_back({v, id});",
      "        g[v].push_back({u, id});",
      "    }",
      "",
      "    void dfs(int u, int pe = -1) {",
      "        tin[u] = low[u] = ++timer;",
      "        int children = 0;",
      "        for (auto [v, id] : g[u]) {",
      "            if (id == pe) continue;",
      "            if (tin[v]) {",
      "                low[u] = min(low[u], tin[v]);",
      "                continue;",
      "            }",
      "            dfs(v, id);",
      "            low[u] = min(low[u], low[v]);",
      "            if (low[v] > tin[u]) bridges.push_back({u, v});",
      "            if (pe != -1 && low[v] >= tin[u]) is_art[u] = 1;",
      "            ++children;",
      "        }",
      "        if (pe == -1 && children > 1) is_art[u] = 1;",
      "    }",
      "",
      "    void build() {",
      "        tin.assign(n + 1, 0);",
      "        low.assign(n + 1, 0);",
      "        is_art.assign(n + 1, 0);",
      "        bridges.clear();",
      "        for (int i = 1; i <= n; ++i) {",
      "            if (!tin[i]) dfs(i);",
      "        }",
      "    }",
      "};"
    ]
  },
  "2-SAT": {
    "prefix": [
      "gr_2sat"
    ],
    "description": "2-SAT solver with implication graph",
    "body": [
      "struct TwoSAT {",
      "    int n;",
      "    vector<vector<int>> g, rg;",
      "    vector<int> comp, order, used, assignment;",
      "",
      "    TwoSAT(int n = 0) {",
      "        init(n);",
      "    }",
      "",
      "    void init(int n_) {",
      "        n = n_;",
      "        g.assign(2 * n, {});",
      "        rg.assign(2 * n, {});",
      "    }",
      "",
      "    int var(int x, bool val) const {",
      "        return 2 * x ^ (val ? 0 : 1);",
      "    }",
      "",
      "    void add_implication(int a, int b) {",
      "        g[a].push_back(b);",
      "        rg[b].push_back(a);",
      "    }",
      "",
      "    void add_or(int a, bool va, int b, bool vb) {",
      "        int x = var(a, va);",
      "        int nx = var(a, !va);",
      "        int y = var(b, vb);",
      "        int ny = var(b, !vb);",
      "        add_implication(nx, y);",
      "        add_implication(ny, x);",
      "    }",
      "",
      "    void add_true(int a, bool va) {",
      "        add_implication(var(a, !va), var(a, va));",
      "    }",
      "",
      "    void dfs1(int u) {",
      "        used[u] = 1;",
      "        for (int v : g[u]) if (!used[v]) dfs1(v);",
      "        order.push_back(u);",
      "    }",
      "",
      "    void dfs2(int u, int c) {",
      "        comp[u] = c;",
      "        for (int v : rg[u]) if (comp[v] == -1) dfs2(v, c);",
      "    }",
      "",
      "    bool solve() {",
      "        used.assign(2 * n, 0);",
      "        comp.assign(2 * n, -1);",
      "        order.clear();",
      "        for (int i = 0; i < 2 * n; ++i) if (!used[i]) dfs1(i);",
      "        reverse(order.begin(), order.end());",
      "        int cc = 0;",
      "        for (int u : order) if (comp[u] == -1) dfs2(u, cc++);",
      "        assignment.assign(n, 0);",
      "        for (int i = 0; i < n; ++i) {",
      "            if (comp[2 * i] == comp[2 * i + 1]) return false;",
      "            assignment[i] = comp[2 * i] > comp[2 * i + 1];",
      "        }",
      "        return true;",
      "    }",
      "};"
    ]
  },
  "Kruskal MST": {
    "prefix": [
      "gr_kruskal"
    ],
    "description": "Kruskal minimum spanning tree",
    "body": [
      "struct KruskalDSU {",
      "    vector<int> p, sz;",
      "",
      "    KruskalDSU(int n = 0) {",
      "        init(n);",
      "    }",
      "",
      "    void init(int n) {",
      "        p.resize(n + 1);",
      "        sz.assign(n + 1, 1);",
      "        iota(p.begin(), p.end(), 0);",
      "    }",
      "",
      "    int find(int x) {",
      "        if (p[x] == x) return x;",
      "        return p[x] = find(p[x]);",
      "    }",
      "",
      "    bool unite(int a, int b) {",
      "        a = find(a);",
      "        b = find(b);",
      "        if (a == b) return false;",
      "        if (sz[a] < sz[b]) swap(a, b);",
      "        p[b] = a;",
      "        sz[a] += sz[b];",
      "        return true;",
      "    }",
      "};",
      "",
      "struct KruskalEdge {",
      "    int u, v;",
      "    long long w;",
      "",
      "    bool operator<(const KruskalEdge& other) const {",
      "        return w < other.w;",
      "    }",
      "};",
      "",
      "pair<long long, vector<KruskalEdge>> kruskal(int n, vector<KruskalEdge> edges) {",
      "    sort(edges.begin(), edges.end());",
      "    KruskalDSU dsu(n);",
      "    long long total = 0;",
      "    vector<KruskalEdge> mst;",
      "    for (auto e : edges) {",
      "        if (dsu.unite(e.u, e.v)) {",
      "            total += e.w;",
      "            mst.push_back(e);",
      "        }",
      "    }",
      "    if ((int)mst.size() != n - 1) return {-(1LL << 60), {}};",
      "    return {total, mst};",
      "}"
    ]
  },
  "LCA Binary Lifting": {
    "prefix": [
      "gr_lca"
    ],
    "description": "Lowest common ancestor with binary lifting",
    "body": [
      "struct LCA {",
      "    int n, lg, root;",
      "    vector<vector<int>> g, up;",
      "    vector<int> depth, tin, tout;",
      "    int timer = 0;",
      "",
      "    LCA(int n = 0) {",
      "        init(n);",
      "    }",
      "",
      "    void init(int n_) {",
      "        n = n_;",
      "        lg = max(1, 32 - __builtin_clz(max(1, n)));",
      "        g.assign(n + 1, {});",
      "        up.assign(lg, vector<int>(n + 1, 0));",
      "        depth.assign(n + 1, 0);",
      "        tin.assign(n + 1, 0);",
      "        tout.assign(n + 1, 0);",
      "        timer = 0;",
      "        root = 1;",
      "    }",
      "",
      "    void add_edge(int u, int v) {",
      "        g[u].push_back(v);",
      "        g[v].push_back(u);",
      "    }",
      "",
      "    void dfs(int u, int p) {",
      "        tin[u] = ++timer;",
      "        up[0][u] = p;",
      "        for (int k = 1; k < lg; ++k) up[k][u] = up[k - 1][up[k - 1][u]];",
      "        for (int v : g[u]) {",
      "            if (v == p) continue;",
      "            depth[v] = depth[u] + 1;",
      "            dfs(v, u);",
      "        }",
      "        tout[u] = timer;",
      "    }",
      "",
      "    void build(int root_ = 1) {",
      "        root = root_;",
      "        depth[root] = 0;",
      "        dfs(root, root);",
      "    }",
      "",
      "    bool is_ancestor(int u, int v) const {",
      "        return tin[u] <= tin[v] && tout[v] <= tout[u];",
      "    }",
      "",
      "    int lca(int u, int v) const {",
      "        if (is_ancestor(u, v)) return u;",
      "        if (is_ancestor(v, u)) return v;",
      "        for (int k = lg - 1; k >= 0; --k) {",
      "            if (!is_ancestor(up[k][u], v)) u = up[k][u];",
      "        }",
      "        return up[0][u];",
      "    }",
      "",
      "    int dist(int u, int v) const {",
      "        int w = lca(u, v);",
      "        return depth[u] + depth[v] - 2 * depth[w];",
      "    }",
      "};"
    ]
  },
  "Heavy Light Decomposition": {
    "prefix": [
      "gr_hld"
    ],
    "description": "Heavy-light decomposition with path decomposition callbacks",
    "body": [
      "struct HLD {",
      "    int n, timer = 0;",
      "    vector<vector<int>> g;",
      "    vector<int> parent, depth, heavy, head, pos, sz;",
      "",
      "    HLD(int n = 0) {",
      "        init(n);",
      "    }",
      "",
      "    void init(int n_) {",
      "        n = n_;",
      "        g.assign(n + 1, {});",
      "        parent.assign(n + 1, 0);",
      "        depth.assign(n + 1, 0);",
      "        heavy.assign(n + 1, -1);",
      "        head.assign(n + 1, 0);",
      "        pos.assign(n + 1, 0);",
      "        sz.assign(n + 1, 0);",
      "        timer = 0;",
      "    }",
      "",
      "    void add_edge(int u, int v) {",
      "        g[u].push_back(v);",
      "        g[v].push_back(u);",
      "    }",
      "",
      "    int dfs(int u, int p) {",
      "        parent[u] = p;",
      "        sz[u] = 1;",
      "        int best = 0;",
      "        for (int v : g[u]) {",
      "            if (v == p) continue;",
      "            depth[v] = depth[u] + 1;",
      "            int cur = dfs(v, u);",
      "            sz[u] += cur;",
      "            if (cur > best) {",
      "                best = cur;",
      "                heavy[u] = v;",
      "            }",
      "        }",
      "        return sz[u];",
      "    }",
      "",
      "    void decompose(int u, int h) {",
      "        head[u] = h;",
      "        pos[u] = timer++;",
      "        if (heavy[u] != -1) decompose(heavy[u], h);",
      "        for (int v : g[u]) {",
      "            if (v == parent[u] || v == heavy[u]) continue;",
      "            decompose(v, v);",
      "        }",
      "    }",
      "",
      "    void build(int root = 1) {",
      "        dfs(root, 0);",
      "        decompose(root, root);",
      "    }",
      "",
      "    template <class F>",
      "    void process_path(int u, int v, F op, bool edge_query = false) const {",
      "        while (head[u] != head[v]) {",
      "            if (depth[head[u]] < depth[head[v]]) swap(u, v);",
      "            op(pos[head[u]], pos[u]);",
      "            u = parent[head[u]];",
      "        }",
      "        if (depth[u] > depth[v]) swap(u, v);",
      "        op(pos[u] + (edge_query ? 1 : 0), pos[v]);",
      "    }",
      "",
      "    pair<int, int> subtree_range(int u) const {",
      "        return {pos[u], pos[u] + sz[u] - 1};",
      "    }",
      "};"
    ]
  },
  "Centroid Decomposition": {
    "prefix": [
      "gr_centroid"
    ],
    "description": "Centroid decomposition on tree",
    "body": [
      "struct CentroidDecomposition {",
      "    int n;",
      "    vector<vector<int>> g;",
      "    vector<int> parent, sz, blocked;",
      "",
      "    CentroidDecomposition(int n = 0) {",
      "        init(n);",
      "    }",
      "",
      "    void init(int n_) {",
      "        n = n_;",
      "        g.assign(n + 1, {});",
      "        parent.assign(n + 1, -1);",
      "        sz.assign(n + 1, 0);",
      "        blocked.assign(n + 1, 0);",
      "    }",
      "",
      "    void add_edge(int u, int v) {",
      "        g[u].push_back(v);",
      "        g[v].push_back(u);",
      "    }",
      "",
      "    int dfs_sz(int u, int p) {",
      "        sz[u] = 1;",
      "        for (int v : g[u]) {",
      "            if (v == p || blocked[v]) continue;",
      "            sz[u] += dfs_sz(v, u);",
      "        }",
      "        return sz[u];",
      "    }",
      "",
      "    int dfs_centroid(int u, int p, int tot) {",
      "        for (int v : g[u]) {",
      "            if (v == p || blocked[v]) continue;",
      "            if (sz[v] * 2 > tot) return dfs_centroid(v, u, tot);",
      "        }",
      "        return u;",
      "    }",
      "",
      "    int build(int entry = 1, int p = -1) {",
      "        int tot = dfs_sz(entry, -1);",
      "        int c = dfs_centroid(entry, -1, tot);",
      "        parent[c] = p;",
      "        blocked[c] = 1;",
      "        for (int v : g[c]) {",
      "            if (!blocked[v]) build(v, c);",
      "        }",
      "        return c;",
      "    }",
      "};"
    ]
  },
  "Directed Euler Trail": {
    "prefix": [
      "gr_euler"
    ],
    "description": "Hierholzer algorithm for directed Euler trail",
    "body": [
      "vector<int> euler_trail_directed(int n, const vector<pair<int, int>>& edges, int start) {",
      "    vector<vector<pair<int, int>>> g(n + 1);",
      "    vector<int> indeg(n + 1, 0), outdeg(n + 1, 0);",
      "    for (int i = 0; i < (int)edges.size(); ++i) {",
      "        auto [u, v] = edges[i];",
      "        g[u].push_back({v, i});",
      "        ++outdeg[u];",
      "        ++indeg[v];",
      "    }",
      "",
      "    vector<int> it(n + 1, 0), used(edges.size(), 0), path, st;",
      "    st.push_back(start);",
      "    while (!st.empty()) {",
      "        int u = st.back();",
      "        while (it[u] < (int)g[u].size() && used[g[u][it[u]].second]) ++it[u];",
      "        if (it[u] == (int)g[u].size()) {",
      "            path.push_back(u);",
      "            st.pop_back();",
      "        } else {",
      "            auto [v, id] = g[u][it[u]++];",
      "            used[id] = 1;",
      "            st.push_back(v);",
      "        }",
      "    }",
      "",
      "    if ((int)path.size() != (int)edges.size() + 1) return {};",
      "    reverse(path.begin(), path.end());",
      "    return path;",
      "}"
    ]
  },
  "Dinic Max Flow": {
    "prefix": [
      "gr_dinic"
    ],
    "description": "Dinic maximum flow",
    "body": [
      "struct Dinic {",
      "    struct Edge {",
      "        int to, rev;",
      "        long long cap;",
      "    };",
      "",
      "    int n;",
      "    vector<vector<Edge>> g;",
      "    vector<int> level, it;",
      "",
      "    Dinic(int n = 0) {",
      "        init(n);",
      "    }",
      "",
      "    void init(int n_) {",
      "        n = n_;",
      "        g.assign(n + 1, {});",
      "    }",
      "",
      "    void add_edge(int u, int v, long long cap) {",
      "        Edge a{v, (int)g[v].size(), cap};",
      "        Edge b{u, (int)g[u].size(), 0};",
      "        g[u].push_back(a);",
      "        g[v].push_back(b);",
      "    }",
      "",
      "    bool bfs(int s, int t) {",
      "        level.assign(n + 1, -1);",
      "        queue<int> q;",
      "        level[s] = 0;",
      "        q.push(s);",
      "        while (!q.empty()) {",
      "            int u = q.front();",
      "            q.pop();",
      "            for (const auto& e : g[u]) {",
      "                if (e.cap > 0 && level[e.to] == -1) {",
      "                    level[e.to] = level[u] + 1;",
      "                    q.push(e.to);",
      "                }",
      "            }",
      "        }",
      "        return level[t] != -1;",
      "    }",
      "",
      "    long long dfs(int u, int t, long long f) {",
      "        if (u == t) return f;",
      "        for (int& i = it[u]; i < (int)g[u].size(); ++i) {",
      "            Edge& e = g[u][i];",
      "            if (e.cap <= 0 || level[e.to] != level[u] + 1) continue;",
      "            long long got = dfs(e.to, t, min(f, e.cap));",
      "            if (!got) continue;",
      "            e.cap -= got;",
      "            g[e.to][e.rev].cap += got;",
      "            return got;",
      "        }",
      "        return 0;",
      "    }",
      "",
      "    long long max_flow(int s, int t) {",
      "        long long flow = 0;",
      "        while (bfs(s, t)) {",
      "            it.assign(n + 1, 0);",
      "            while (long long pushed = dfs(s, t, (1LL << 62))) flow += pushed;",
      "        }",
      "        return flow;",
      "    }",
      "};"
    ]
  },
  "Min Cost Max Flow": {
    "prefix": [
      "gr_mcmf"
    ],
    "description": "Successive shortest augmenting path min-cost max-flow",
    "body": [
      "struct MCMF {",
      "    struct Edge {",
      "        int to, rev;",
      "        long long cap, cost;",
      "    };",
      "",
      "    int n;",
      "    vector<vector<Edge>> g;",
      "",
      "    MCMF(int n = 0) {",
      "        init(n);",
      "    }",
      "",
      "    void init(int n_) {",
      "        n = n_;",
      "        g.assign(n + 1, {});",
      "    }",
      "",
      "    void add_edge(int u, int v, long long cap, long long cost) {",
      "        Edge a{v, (int)g[v].size(), cap, cost};",
      "        Edge b{u, (int)g[u].size(), 0, -cost};",
      "        g[u].push_back(a);",
      "        g[v].push_back(b);",
      "    }",
      "",
      "    pair<long long, long long> min_cost_max_flow(int s, int t, long long need = (1LL << 62)) {",
      "        const long long INF = (1LL << 62);",
      "        long long flow = 0, cost = 0;",
      "        vector<long long> dist(n + 1), inq(n + 1), pv_v(n + 1), pv_e(n + 1);",
      "",
      "        while (flow < need) {",
      "            fill(dist.begin(), dist.end(), INF);",
      "            fill(inq.begin(), inq.end(), 0);",
      "            queue<int> q;",
      "            dist[s] = 0;",
      "            q.push(s);",
      "            inq[s] = 1;",
      "",
      "            while (!q.empty()) {",
      "                int u = q.front();",
      "                q.pop();",
      "                inq[u] = 0;",
      "                for (int i = 0; i < (int)g[u].size(); ++i) {",
      "                    const Edge& e = g[u][i];",
      "                    if (e.cap == 0) continue;",
      "                    if (dist[e.to] > dist[u] + e.cost) {",
      "                        dist[e.to] = dist[u] + e.cost;",
      "                        pv_v[e.to] = u;",
      "                        pv_e[e.to] = i;",
      "                        if (!inq[e.to]) {",
      "                            inq[e.to] = 1;",
      "                            q.push(e.to);",
      "                        }",
      "                    }",
      "                }",
      "            }",
      "",
      "            if (dist[t] == INF) break;",
      "            long long add = need - flow;",
      "            for (int v = t; v != s; v = pv_v[v]) {",
      "                add = min(add, g[pv_v[v]][pv_e[v]].cap);",
      "            }",
      "            for (int v = t; v != s; v = pv_v[v]) {",
      "                Edge& e = g[pv_v[v]][pv_e[v]];",
      "                e.cap -= add;",
      "                g[v][e.rev].cap += add;",
      "                cost += add * e.cost;",
      "            }",
      "            flow += add;",
      "        }",
      "",
      "        return {flow, cost};",
      "    }",
      "};"
    ]
  },
  "Hopcroft Karp": {
    "prefix": [
      "gr_hk"
    ],
    "description": "Hopcroft-Karp maximum matching on bipartite graph",
    "body": [
      "struct HopcroftKarp {",
      "    int n_left, n_right;",
      "    vector<vector<int>> g;",
      "    vector<int> dist, matchL, matchR;",
      "",
      "    HopcroftKarp(int n_left = 0, int n_right = 0) {",
      "        init(n_left, n_right);",
      "    }",
      "",
      "    void init(int nl, int nr) {",
      "        n_left = nl;",
      "        n_right = nr;",
      "        g.assign(n_left + 1, {});",
      "        matchL.assign(n_left + 1, 0);",
      "        matchR.assign(n_right + 1, 0);",
      "        dist.assign(n_left + 1, 0);",
      "    }",
      "",
      "    void add_edge(int u, int v) {",
      "        g[u].push_back(v);",
      "    }",
      "",
      "    bool bfs() {",
      "        queue<int> q;",
      "        for (int u = 1; u <= n_left; ++u) {",
      "            if (!matchL[u]) {",
      "                dist[u] = 0;",
      "                q.push(u);",
      "            } else {",
      "                dist[u] = -1;",
      "            }",
      "        }",
      "        bool ok = false;",
      "        while (!q.empty()) {",
      "            int u = q.front();",
      "            q.pop();",
      "            for (int v : g[u]) {",
      "                int w = matchR[v];",
      "                if (!w) {",
      "                    ok = true;",
      "                } else if (dist[w] == -1) {",
      "                    dist[w] = dist[u] + 1;",
      "                    q.push(w);",
      "                }",
      "            }",
      "        }",
      "        return ok;",
      "    }",
      "",
      "    bool dfs(int u) {",
      "        for (int v : g[u]) {",
      "            int w = matchR[v];",
      "            if (!w || (dist[w] == dist[u] + 1 && dfs(w))) {",
      "                matchL[u] = v;",
      "                matchR[v] = u;",
      "                return true;",
      "            }",
      "        }",
      "        dist[u] = -1;",
      "        return false;",
      "    }",
      "",
      "    int max_matching() {",
      "        int matching = 0;",
      "        while (bfs()) {",
      "            for (int u = 1; u <= n_left; ++u) {",
      "                if (!matchL[u] && dfs(u)) ++matching;",
      "            }",
      "        }",
      "        return matching;",
      "    }",
      "};"
    ]
  }
}
