{
  "Coordinate Compression": {
    "prefix": [
      "tc_compress"
    ],
    "description": "Coordinate compression helper",
    "body": [
      "template <class T>",
      "pair<vector<T>, vector<int>> compress_values(const vector<T>& a) {",
      "    vector<T> vals = a;",
      "    sort(vals.begin(), vals.end());",
      "    vals.erase(unique(vals.begin(), vals.end()), vals.end());",
      "    vector<int> idx(a.size());",
      "    for (int i = 0; i < (int)a.size(); ++i) {",
      "        idx[i] = (int)(lower_bound(vals.begin(), vals.end(), a[i]) - vals.begin());",
      "    }",
      "    return {vals, idx};",
      "}"
    ]
  },
  "Mo Ordering": {
    "prefix": [
      "tc_mo"
    ],
    "description": "Mo algorithm query ordering",
    "body": [
      "struct MoQuery {",
      "    int l, r, id;",
      "};",
      "",
      "vector<int> mo_order(vector<MoQuery> qs, int n) {",
      "    int block = max(1, (int)sqrt(n));",
      "    sort(qs.begin(), qs.end(), [&](const MoQuery& a, const MoQuery& b) {",
      "        int ba = a.l / block;",
      "        int bb = b.l / block;",
      "        if (ba != bb) return ba < bb;",
      "        if (ba & 1) return a.r > b.r;",
      "        return a.r < b.r;",
      "    });",
      "    vector<int> ord;",
      "    ord.reserve(qs.size());",
      "    for (auto q : qs) ord.push_back(q.id);",
      "    return ord;",
      "}"
    ]
  },
  "DSU on Tree Skeleton": {
    "prefix": [
      "tc_sack"
    ],
    "description": "DSU on tree (sack) skeleton",
    "body": [
      "struct Sack {",
      "    int n, timer = 0;",
      "    vector<vector<int>> g;",
      "    vector<int> sz, heavy, st, en, euler;",
      "",
      "    Sack(int n = 0) {",
      "        init(n);",
      "    }",
      "",
      "    void init(int n_) {",
      "        n = n_;",
      "        g.assign(n + 1, {});",
      "        sz.assign(n + 1, 0);",
      "        heavy.assign(n + 1, -1);",
      "        st.assign(n + 1, 0);",
      "        en.assign(n + 1, 0);",
      "        euler.assign(n + 1, 0);",
      "        timer = 0;",
      "    }",
      "",
      "    void add_edge(int u, int v) {",
      "        g[u].push_back(v);",
      "        g[v].push_back(u);",
      "    }",
      "",
      "    void add_vertex(int u) {",
      "        // user code",
      "        (void)u;",
      "    }",
      "",
      "    void remove_vertex(int u) {",
      "        // user code",
      "        (void)u;",
      "    }",
      "",
      "    void answer_query(int u) {",
      "        // user code",
      "        (void)u;",
      "    }",
      "",
      "    void dfs_sz(int u, int p) {",
      "        sz[u] = 1;",
      "        st[u] = timer;",
      "        euler[timer++] = u;",
      "        int best = 0;",
      "        for (int v : g[u]) {",
      "            if (v == p) continue;",
      "            dfs_sz(v, u);",
      "            sz[u] += sz[v];",
      "            if (sz[v] > best) {",
      "                best = sz[v];",
      "                heavy[u] = v;",
      "            }",
      "        }",
      "        en[u] = timer - 1;",
      "    }",
      "",
      "    void add_subtree(int u, int p, int skip, bool add) {",
      "        for (int v : g[u]) {",
      "            if (v == p || v == skip) continue;",
      "            add_subtree(v, u, skip, add);",
      "        }",
      "        if (add) add_vertex(u);",
      "        else remove_vertex(u);",
      "    }",
      "",
      "    void dfs(int u, int p, bool keep) {",
      "        for (int v : g[u]) {",
      "            if (v == p || v == heavy[u]) continue;",
      "            dfs(v, u, false);",
      "        }",
      "        if (heavy[u] != -1) dfs(heavy[u], u, true);",
      "        for (int v : g[u]) {",
      "            if (v == p || v == heavy[u]) continue;",
      "            add_subtree(v, u, -1, true);",
      "        }",
      "        add_vertex(u);",
      "        answer_query(u);",
      "        if (!keep) add_subtree(u, p, -1, false);",
      "    }",
      "};"
    ]
  },
  "Rerooting DP": {
    "prefix": [
      "tc_reroot"
    ],
    "description": "Generic rerooting DP on trees",
    "body": [
      "template <class T>",
      "struct Rerooting {",
      "    int n;",
      "    vector<vector<int>> g;",
      "    function<T()> ident;",
      "    function<T(const T&, const T&)> merge;",
      "    function<T(const T&, int, int)> add_root;",
      "    vector<T> down, ans;",
      "",
      "    Rerooting(int n,",
      "              function<T()> ident,",
      "              function<T(const T&, const T&)> merge,",
      "              function<T(const T&, int, int)> add_root)",
      "        : n(n), g(n + 1), ident(ident), merge(merge), add_root(add_root), down(n + 1), ans(n + 1) {}",
      "",
      "    void add_edge(int u, int v) {",
      "        g[u].push_back(v);",
      "        g[v].push_back(u);",
      "    }",
      "",
      "    void dfs1(int u, int p) {",
      "        T acc = ident();",
      "        for (int v : g[u]) {",
      "            if (v == p) continue;",
      "            dfs1(v, u);",
      "            acc = merge(acc, add_root(down[v], v, u));",
      "        }",
      "        down[u] = acc;",
      "    }",
      "",
      "    void dfs2(int u, int p, T from_parent) {",
      "        int m = (int)g[u].size();",
      "        vector<T> pref(m + 1, ident()), suff(m + 1, ident());",
      "        for (int i = 0; i < m; ++i) {",
      "            int v = g[u][i];",
      "            T cur = (v == p ? from_parent : add_root(down[v], v, u));",
      "            pref[i + 1] = merge(pref[i], cur);",
      "        }",
      "        for (int i = m - 1; i >= 0; --i) {",
      "            int v = g[u][i];",
      "            T cur = (v == p ? from_parent : add_root(down[v], v, u));",
      "            suff[i] = merge(cur, suff[i + 1]);",
      "        }",
      "        ans[u] = pref[m];",
      "        for (int i = 0; i < m; ++i) {",
      "            int v = g[u][i];",
      "            if (v == p) continue;",
      "            T without_v = merge(pref[i], suff[i + 1]);",
      "            dfs2(v, u, add_root(without_v, u, v));",
      "        }",
      "    }",
      "",
      "    vector<T> build(int root = 1) {",
      "        dfs1(root, 0);",
      "        dfs2(root, 0, ident());",
      "        return ans;",
      "    }",
      "};"
    ]
  },
  "Divide and Conquer DP": {
    "prefix": [
      "tc_dnc_dp"
    ],
    "description": "Divide and conquer DP optimization skeleton",
    "body": [
      "template <class Cost>",
      "void divide_conquer_dp(int l, int r, int optl, int optr, const vector<long long>& prev, vector<long long>& cur, Cost cost) {",
      "    if (l > r) return;",
      "    int mid = (l + r) >> 1;",
      "    pair<long long, int> best{(1LL << 62), -1};",
      "    for (int k = optl; k <= min(mid, optr); ++k) {",
      "        long long cand = prev[k] + cost(k, mid);",
      "        if (cand < best.first) best = {cand, k};",
      "    }",
      "    cur[mid] = best.first;",
      "    divide_conquer_dp(l, mid - 1, optl, best.second, prev, cur, cost);",
      "    divide_conquer_dp(mid + 1, r, best.second, optr, prev, cur, cost);",
      "}"
    ]
  },
  "Knuth Optimization": {
    "prefix": [
      "tc_knuth"
    ],
    "description": "Knuth optimization for interval DP",
    "body": [
      "template <class Cost>",
      "pair<vector<vector<long long>>, vector<vector<int>>> knuth_optimization(int n, Cost cost) {",
      "    const long long INF = (1LL << 62);",
      "    vector<vector<long long>> dp(n, vector<long long>(n, 0));",
      "    vector<vector<int>> opt(n, vector<int>(n, 0));",
      "    for (int i = 0; i < n; ++i) opt[i][i] = i;",
      "",
      "    for (int len = 2; len <= n; ++len) {",
      "        for (int l = 0; l + len - 1 < n; ++l) {",
      "            int r = l + len - 1;",
      "            dp[l][r] = INF;",
      "            int start = opt[l][r - 1];",
      "            int finish = opt[l + 1][r];",
      "            for (int k = start; k <= min(r - 1, finish); ++k) {",
      "                long long cand = dp[l][k] + dp[k + 1][r] + cost(l, r);",
      "                if (cand < dp[l][r]) {",
      "                    dp[l][r] = cand;",
      "                    opt[l][r] = k;",
      "                }",
      "            }",
      "        }",
      "    }",
      "",
      "    return {dp, opt};",
      "}"
    ]
  },
  "SOS DP": {
    "prefix": [
      "tc_sos"
    ],
    "description": "Subset and superset zeta transforms",
    "body": [
      "template <class T>",
      "void sos_subset(vector<T>& f, int bits) {",
      "    for (int b = 0; b < bits; ++b) {",
      "        for (int mask = 0; mask < (1 << bits); ++mask) {",
      "            if (mask & (1 << b)) f[mask] += f[mask ^ (1 << b)];",
      "        }",
      "    }",
      "}",
      "",
      "template <class T>",
      "void sos_superset(vector<T>& f, int bits) {",
      "    for (int b = 0; b < bits; ++b) {",
      "        for (int mask = 0; mask < (1 << bits); ++mask) {",
      "            if ((mask & (1 << b)) == 0) f[mask] += f[mask | (1 << b)];",
      "        }",
      "    }",
      "}"
    ]
  },
  "Submask Enumeration": {
    "prefix": [
      "tc_submask"
    ],
    "description": "Submask and supermask iteration idioms",
    "body": [
      "void iterate_submasks(int mask) {",
      "    for (int sub = mask; ; sub = (sub - 1) & mask) {",
      "        // use sub",
      "        if (sub == 0) break;",
      "    }",
      "}",
      "",
      "void iterate_supermasks(int mask, int bits) {",
      "    int full = (1 << bits) - 1;",
      "    for (int sup = mask; sup <= full; sup = (sup + 1) | mask) {",
      "        // use sup",
      "        if (sup == full) break;",
      "    }",
      "}"
    ]
  },
  "LIS": {
    "prefix": [
      "tc_lis"
    ],
    "description": "Longest increasing subsequence length and one reconstruction",
    "body": [
      "template <class T>",
      "vector<T> lis_reconstruct(const vector<T>& a) {",
      "    int n = (int)a.size();",
      "    if (n == 0) return {};",
      "    vector<T> tail;",
      "    vector<int> pos, pre(n, -1);",
      "",
      "    for (int i = 0; i < n; ++i) {",
      "        int j = (int)(lower_bound(tail.begin(), tail.end(), a[i]) - tail.begin());",
      "        if (j == (int)tail.size()) {",
      "            tail.push_back(a[i]);",
      "            pos.push_back(i);",
      "        } else {",
      "            tail[j] = a[i];",
      "            pos[j] = i;",
      "        }",
      "        if (j > 0) pre[i] = pos[j - 1];",
      "    }",
      "",
      "    vector<T> seq;",
      "    for (int cur = pos.back(); cur != -1; cur = pre[cur]) seq.push_back(a[cur]);",
      "    reverse(seq.begin(), seq.end());",
      "    return seq;",
      "}"
    ]
  },
  "Meet in the Middle Subset Sum": {
    "prefix": [
      "tc_mitm"
    ],
    "description": "Meet-in-the-middle subset sums",
    "body": [
      "vector<long long> subset_sums(const vector<long long>& a) {",
      "    int n = (int)a.size();",
      "    vector<long long> res;",
      "    res.reserve(1 << n);",
      "    for (int mask = 0; mask < (1 << n); ++mask) {",
      "        long long sum = 0;",
      "        for (int i = 0; i < n; ++i) {",
      "            if (mask >> i & 1) sum += a[i];",
      "        }",
      "        res.push_back(sum);",
      "    }",
      "    sort(res.begin(), res.end());",
      "    return res;",
      "}"
    ]
  }
}
