{
  "Prefix Function": {
    "prefix": [
      "str_pi"
    ],
    "description": "Prefix function for KMP",
    "body": [
      "vector<int> prefix_function(const string& s) {",
      "    int n = (int)s.size();",
      "    vector<int> pi(n, 0);",
      "    for (int i = 1; i < n; ++i) {",
      "        int j = pi[i - 1];",
      "        while (j > 0 && s[i] != s[j]) j = pi[j - 1];",
      "        if (s[i] == s[j]) ++j;",
      "        pi[i] = j;",
      "    }",
      "    return pi;",
      "}"
    ]
  },
  "KMP Search": {
    "prefix": [
      "str_kmp"
    ],
    "description": "Find all occurrences of pattern in text with KMP",
    "body": [
      "vector<int> kmp_search(const string& text, const string& pat) {",
      "    if (pat.empty()) return {};",
      "    int m = (int)pat.size();",
      "    vector<int> pi(m, 0);",
      "    for (int i = 1; i < m; ++i) {",
      "        int j = pi[i - 1];",
      "        while (j > 0 && pat[i] != pat[j]) j = pi[j - 1];",
      "        if (pat[i] == pat[j]) ++j;",
      "        pi[i] = j;",
      "    }",
      "",
      "    vector<int> occ;",
      "    int j = 0;",
      "    for (int i = 0; i < (int)text.size(); ++i) {",
      "        while (j > 0 && text[i] != pat[j]) j = pi[j - 1];",
      "        if (text[i] == pat[j]) ++j;",
      "        if (j == m) {",
      "            occ.push_back(i - m + 1);",
      "            j = pi[j - 1];",
      "        }",
      "    }",
      "    return occ;",
      "}"
    ]
  },
  "Z Function": {
    "prefix": [
      "str_z"
    ],
    "description": "Z-function",
    "body": [
      "vector<int> z_function(const string& s) {",
      "    int n = (int)s.size();",
      "    vector<int> z(n, 0);",
      "    int l = 0, r = 0;",
      "    for (int i = 1; i < n; ++i) {",
      "        if (i <= r) z[i] = min(r - i + 1, z[i - l]);",
      "        while (i + z[i] < n && s[z[i]] == s[i + z[i]]) ++z[i];",
      "        if (i + z[i] - 1 > r) {",
      "            l = i;",
      "            r = i + z[i] - 1;",
      "        }",
      "    }",
      "    return z;",
      "}"
    ]
  },
  "Rolling Hash": {
    "prefix": [
      "str_hash"
    ],
    "description": "Unsigned 64-bit polynomial rolling hash",
    "body": [
      "struct RollingHash {",
      "    static const uint64_t BASE = 911382323ULL;",
      "    vector<uint64_t> h, p;",
      "",
      "    RollingHash(const string& s = \"\") {",
      "        if (!s.empty()) build(s);",
      "    }",
      "",
      "    void build(const string& s) {",
      "        int n = (int)s.size();",
      "        h.assign(n + 1, 0);",
      "        p.assign(n + 1, 1);",
      "        for (int i = 0; i < n; ++i) {",
      "            h[i + 1] = h[i] * BASE + (uint64_t)(unsigned char)s[i] + 1;",
      "            p[i + 1] = p[i] * BASE;",
      "        }",
      "    }",
      "",
      "    uint64_t get(int l, int r) const {",
      "        return h[r + 1] - h[l] * p[r - l + 1];",
      "    }",
      "};"
    ]
  },
  "Manacher": {
    "prefix": [
      "str_manacher"
    ],
    "description": "Palindrome radii for odd and even centers",
    "body": [
      "pair<vector<int>, vector<int>> manacher(const string& s) {",
      "    int n = (int)s.size();",
      "    vector<int> d1(n), d2(n);",
      "",
      "    for (int i = 0, l = 0, r = -1; i < n; ++i) {",
      "        int k = (i > r) ? 1 : min(d1[l + r - i], r - i + 1);",
      "        while (0 <= i - k && i + k < n && s[i - k] == s[i + k]) ++k;",
      "        d1[i] = k--;",
      "        if (i + k > r) {",
      "            l = i - k;",
      "            r = i + k;",
      "        }",
      "    }",
      "",
      "    for (int i = 0, l = 0, r = -1; i < n; ++i) {",
      "        int k = (i > r) ? 0 : min(d2[l + r - i + 1], r - i + 1);",
      "        while (0 <= i - k - 1 && i + k < n && s[i - k - 1] == s[i + k]) ++k;",
      "        d2[i] = k--;",
      "        if (i + k > r) {",
      "            l = i - k - 1;",
      "            r = i + k;",
      "        }",
      "    }",
      "",
      "    return {d1, d2};",
      "}"
    ]
  },
  "Aho Corasick": {
    "prefix": [
      "str_aho"
    ],
    "description": "Aho-Corasick automaton for lowercase strings",
    "body": [
      "struct AhoCorasick {",
      "    struct Node {",
      "        array<int, 26> nxt;",
      "        int link = 0;",
      "        vector<int> out;",
      "",
      "        Node() {",
      "            nxt.fill(-1);",
      "        }",
      "    };",
      "",
      "    int patterns = 0;",
      "    vector<Node> t{{}};",
      "",
      "    int add_word(const string& s) {",
      "        int u = 0;",
      "        for (char ch : s) {",
      "            int c = ch - 'a';",
      "            if (t[u].nxt[c] == -1) {",
      "                t[u].nxt[c] = (int)t.size();",
      "                t.push_back(Node());",
      "            }",
      "            u = t[u].nxt[c];",
      "        }",
      "        int id = patterns++;",
      "        t[u].out.push_back(id);",
      "        return id;",
      "    }",
      "",
      "    void build() {",
      "        queue<int> q;",
      "        for (int c = 0; c < 26; ++c) {",
      "            int v = t[0].nxt[c];",
      "            if (v == -1) {",
      "                t[0].nxt[c] = 0;",
      "            } else {",
      "                t[v].link = 0;",
      "                q.push(v);",
      "            }",
      "        }",
      "",
      "        while (!q.empty()) {",
      "            int u = q.front();",
      "            q.pop();",
      "            for (int c = 0; c < 26; ++c) {",
      "                int v = t[u].nxt[c];",
      "                if (v == -1) {",
      "                    t[u].nxt[c] = t[t[u].link].nxt[c];",
      "                    continue;",
      "                }",
      "                t[v].link = t[t[u].link].nxt[c];",
      "                auto& out = t[v].out;",
      "                auto& add = t[t[v].link].out;",
      "                out.insert(out.end(), add.begin(), add.end());",
      "                q.push(v);",
      "            }",
      "        }",
      "    }",
      "",
      "    vector<pair<int, int>> find_all(const string& s) const {",
      "        vector<pair<int, int>> res;",
      "        int u = 0;",
      "        for (int i = 0; i < (int)s.size(); ++i) {",
      "            int c = s[i] - 'a';",
      "            u = t[u].nxt[c];",
      "            for (int id : t[u].out) res.push_back({i, id});",
      "        }",
      "        return res;",
      "    }",
      "};"
    ]
  },
  "Suffix Array and LCP": {
    "prefix": [
      "str_sa"
    ],
    "description": "Suffix array O(n log n) with LCP",
    "body": [
      "struct SuffixArray {",
      "    string s;",
      "    vector<int> sa, rnk, lcp;",
      "",
      "    SuffixArray(const string& s = \"\") {",
      "        if (!s.empty()) build(s);",
      "    }",
      "",
      "    void build(const string& str) {",
      "        s = str;",
      "        int n = (int)s.size();",
      "        sa.resize(n);",
      "        rnk.resize(n);",
      "        vector<int> tmp(n);",
      "        for (int i = 0; i < n; ++i) {",
      "            sa[i] = i;",
      "            rnk[i] = s[i];",
      "        }",
      "",
      "        for (int k = 1;; k <<= 1) {",
      "            auto cmp = [&](int i, int j) {",
      "                if (rnk[i] != rnk[j]) return rnk[i] < rnk[j];",
      "                int ri = i + k < n ? rnk[i + k] : -1;",
      "                int rj = j + k < n ? rnk[j + k] : -1;",
      "                return ri < rj;",
      "            };",
      "            sort(sa.begin(), sa.end(), cmp);",
      "            tmp[sa[0]] = 0;",
      "            for (int i = 1; i < n; ++i) tmp[sa[i]] = tmp[sa[i - 1]] + cmp(sa[i - 1], sa[i]);",
      "            rnk = tmp;",
      "            if (rnk[sa[n - 1]] == n - 1) break;",
      "        }",
      "",
      "        lcp.assign(max(0, n - 1), 0);",
      "        for (int i = 0, h = 0; i < n; ++i) {",
      "            int rk = rnk[i];",
      "            if (rk == 0) continue;",
      "            int j = sa[rk - 1];",
      "            while (i + h < n && j + h < n && s[i + h] == s[j + h]) ++h;",
      "            lcp[rk - 1] = h;",
      "            if (h) --h;",
      "        }",
      "    }",
      "};"
    ]
  },
  "Suffix Automaton": {
    "prefix": [
      "str_sam"
    ],
    "description": "Suffix automaton",
    "body": [
      "struct SuffixAutomaton {",
      "    struct State {",
      "        int link = -1, len = 0;",
      "        array<int, 26> next;",
      "",
      "        State() {",
      "            next.fill(-1);",
      "        }",
      "    };",
      "",
      "    vector<State> st{{}};",
      "    int last = 0;",
      "",
      "    int extend(char ch) {",
      "        int c = ch - 'a';",
      "        int cur = (int)st.size();",
      "        st.push_back(State());",
      "        st[cur].len = st[last].len + 1;",
      "        int p = last;",
      "        while (p != -1 && st[p].next[c] == -1) {",
      "            st[p].next[c] = cur;",
      "            p = st[p].link;",
      "        }",
      "        if (p == -1) {",
      "            st[cur].link = 0;",
      "        } else {",
      "            int q = st[p].next[c];",
      "            if (st[p].len + 1 == st[q].len) {",
      "                st[cur].link = q;",
      "            } else {",
      "                int clone = (int)st.size();",
      "                st.push_back(st[q]);",
      "                st[clone].len = st[p].len + 1;",
      "                while (p != -1 && st[p].next[c] == q) {",
      "                    st[p].next[c] = clone;",
      "                    p = st[p].link;",
      "                }",
      "                st[q].link = st[cur].link = clone;",
      "            }",
      "        }",
      "        last = cur;",
      "        return cur;",
      "    }",
      "",
      "    void build(const string& s) {",
      "        st.assign(1, State());",
      "        st[0].link = -1;",
      "        last = 0;",
      "        for (char ch : s) extend(ch);",
      "    }",
      "};"
    ]
  },
  "Eertree": {
    "prefix": [
      "str_eertree"
    ],
    "description": "Palindromic tree",
    "body": [
      "struct Eertree {",
      "    struct Node {",
      "        int len, link;",
      "        array<int, 26> next;",
      "        int occ = 0;",
      "",
      "        Node(int len = 0, int link = 0) : len(len), link(link) {",
      "            next.fill(0);",
      "        }",
      "    };",
      "",
      "    string s = \"#\";",
      "    vector<Node> tree;",
      "    int suff;",
      "",
      "    Eertree() {",
      "        init();",
      "    }",
      "",
      "    void init() {",
      "        tree.clear();",
      "        tree.push_back(Node(-1, 0));",
      "        tree.push_back(Node(0, 0));",
      "        suff = 1;",
      "        s = \"#\";",
      "    }",
      "",
      "    int get_link(int v) const {",
      "        int pos = (int)s.size() - 1;",
      "        while (s[pos - 1 - tree[v].len] != s.back()) v = tree[v].link;",
      "        return v;",
      "    }",
      "",
      "    int add_char(char ch) {",
      "        s.push_back(ch);",
      "        int cur = get_link(suff);",
      "        int c = ch - 'a';",
      "        if (!tree[cur].next[c]) {",
      "            int now = (int)tree.size();",
      "            tree.push_back(Node(tree[cur].len + 2, 0));",
      "            if (tree.back().len == 1) {",
      "                tree.back().link = 1;",
      "            } else {",
      "                int link = get_link(tree[cur].link);",
      "                tree.back().link = tree[link].next[c];",
      "            }",
      "            tree[cur].next[c] = now;",
      "        }",
      "        suff = tree[cur].next[c];",
      "        ++tree[suff].occ;",
      "        return suff;",
      "    }",
      "};"
    ]
  },
  "Booth Minimum Rotation": {
    "prefix": [
      "str_booth"
    ],
    "description": "Lexicographically minimum string rotation",
    "body": [
      "int booth_min_rotation(const string& s) {",
      "    string t = s + s;",
      "    int n = (int)s.size();",
      "    int i = 0, j = 1, k = 0;",
      "    while (i < n && j < n && k < n) {",
      "        if (t[i + k] == t[j + k]) {",
      "            ++k;",
      "            continue;",
      "        }",
      "        if (t[i + k] > t[j + k]) {",
      "            i += k + 1;",
      "            if (i <= j) i = j + 1;",
      "        } else {",
      "            j += k + 1;",
      "            if (j <= i) j = i + 1;",
      "        }",
      "        k = 0;",
      "    }",
      "    return min(i, j);",
      "}"
    ]
  },
  "Duval Lyndon Factorization": {
    "prefix": [
      "str_duval"
    ],
    "description": "Lyndon factorization by Duval algorithm",
    "body": [
      "vector<string> duval(const string& s) {",
      "    int n = (int)s.size();",
      "    vector<string> res;",
      "    for (int i = 0; i < n;) {",
      "        int j = i + 1, k = i;",
      "        while (j < n && s[k] <= s[j]) {",
      "            if (s[k] < s[j]) k = i;",
      "            else ++k;",
      "            ++j;",
      "        }",
      "        while (i <= k) {",
      "            res.push_back(s.substr(i, j - k));",
      "            i += j - k;",
      "        }",
      "    }",
      "    return res;",
      "}"
    ]
  }
}
